@page "/workspace"

@using ShapeEditor.Core.Models
@using ShapeEditor.Core.Physics
@using ShapeEditor.Core.Services
@using ShapeEditor.Web.Models
@using ShapeEditor.Web.Services
@implements IDisposable
@inject WorkspaceStore Store
@inject NavigationManager Nav

<PageTitle>图形工作区</PageTitle>

<SiteHeader Active="workspace" />

<div class="workspace-page">

    <header class="editor-header">
        <h1>制作路径</h1>

        <div class="header-actions">
            <div class="code-format">
                <button class="@ModeClass(CollapseMode.IncludeCycles)"
                        @onclick="() => _mode = CollapseMode.IncludeCycles">
                    含循环支撑
                </button>
                <button class="@ModeClass(CollapseMode.FloorOnly)"
                        @onclick="() => _mode = CollapseMode.FloorOnly">
                    仅地面
                </button>
            </div>

            <button class="secondary-button"
                    disabled="@(Store.Nodes.Count == 0)"
                    @onclick="ExportGraph">
                导出图片
            </button>

            <button class="secondary-button"
                    disabled="@(Store.Nodes.Count == 0)"
                    @onclick="ConfirmClear">
                清空画布
            </button>
        </div>
    </header>

    <div class="workspace-body">

        <aside class="workspace-list">
            <div class="tool-title">素材</div>

            @if (Store.Items.Count == 0)
            {
                <div class="batch-hint">
                    空。到编辑器点「加入工作区」，或批量导入。
                </div>
            }

            @foreach (WorkspaceItem item in Store.Items)
            {
                <div class="ws-card @(_selectedMaterial?.Id == item.Id ? "selected" : "")"
                     @onclick="() => _selectedMaterial = item">

                    <div class="ws-thumb">
                        @if (Store.GetDocument(item, out _) is ShapeDocument document)
                        {
                            <ShapePreview Document="document" CssClass="ws-preview" />
                        }
                    </div>

                    <div class="ws-info">
                        <div class="ws-name-plain">@item.Name</div>
                        <div class="ws-meta">@item.DimensionText</div>
                    </div>
                </div>
            }
        </aside>

        <section class="graph-canvas-wrapper">
            <div class="graph-canvas" style="@CanvasStyle">

                <svg class="graph-edges" width="@CanvasWidth" height="@CanvasHeight">
                    <defs>
                        <marker id="arrow" markerWidth="10" markerHeight="10"
                                refX="8" refY="3" orient="auto">
                            <path d="M0,0 L0,6 L9,3 z" fill="#512bd4" />
                        </marker>
                    </defs>

                    @foreach (EdgeView edge in EdgeViews)
                    {
                        <path d="@edge.Path"
                              fill="none"
                              stroke="#512bd4"
                              stroke-width="2"
                              marker-end="url(#arrow)" />
                    }
                </svg>

                @foreach (EdgeView edge in EdgeViews)
                {
                    <div class="graph-edge-label-html"
                         style="left:@(edge.LabelX)px;top:@(edge.LabelY)px;">
                        @edge.Label
                    </div>
                }

                @foreach (WorkspaceNode node in Store.Nodes)
                {
                    <div class="graph-node @(node.IsResult ? "result" : "") @(node.Kind == "ref" ? "ref" : "") @(Store.SelectedNode?.Id == node.Id ? "selected" : "")"
                         style="@NodeStyle(node)"
                         @onclick="() => Store.SelectNode(node)">

                        <div class="graph-node-head">
                            <span class="graph-node-title">#@node.Seq · @NodeTitle(node)</span>

                            <button class="node-delete"
                                    title="删除该节点及其下游"
                                    @onclick="() => ConfirmDelete(node)">
                                ×
                            </button>
                        </div>

                        <div class="graph-node-body">
                            @if (NodeDocument(node) is ShapeDocument document)
                            {
                                <ShapePreview Document="document" CssClass="graph-preview" />
                            }
                            else if (node.Kind == "ref")
                            {
                                <span class="ws-slot-empty">选择输入</span>
                            }
                            else
                            {
                                <span class="ws-slot-empty">空</span>
                            }
                        </div>

                        @if (node.Kind == "ref")
                        {
                            <select class="graph-select"
                                    @onchange="e => OnSelectTarget(node, e.Value?.ToString())">
                                <option value="">选择已有节点</option>
                                @foreach (WorkspaceNode candidate in TargetCandidates(node))
                                {
                                    <option value="@candidate.Id">@NodeTitle(candidate) · @candidate.Layers 层</option>
                                }
                            </select>

                            @if (_selectedMaterial is not null && !node.HasShape)
                            {
                                <button class="secondary-button"
                                        @onclick="() => ImportMaterialIntoRef(node)">
                                    导入所选素材
                                </button>
                            }

                            <button class="secondary-button"
                                    disabled="@(Store.SelectedNode is null || Store.SelectedNode.Id == node.BaseId || !Store.SelectedNode.HasShape)"
                                    @onclick="() => ReferenceSelected(node)">
                                引用所选节点
                            </button>

                            @if (Store.FindNode(node.TargetId) is WorkspaceNode target)
                            {
                                <div class="ws-meta">引用 #@target.Seq</div>
                            }

                            <button class="primary-button"
                                    disabled="@(ResolveSlot(node) is null)"
                                    @onclick="() => ComputeStack(node)">
                                计算
                            </button>
                        }
                        else
                        {
                            @if (!node.IsResult && _selectedMaterial is not null)
                            {
                                <button class="secondary-button"
                                        @onclick="() => ImportMaterial(node)">
                                    导入所选
                                </button>
                            }

                            <div class="node-actions">
                                <button class="mini-button" @onclick='() => Apply(node, "collapse")'>下落</button>
                                <button class="mini-button" @onclick='() => Apply(node, "pin")'>顶针</button>
                                <button class="mini-button" @onclick='() => Apply(node, "cut")'>切割</button>
                                <button class="mini-button" @onclick='() => BeginStack(node, false)'>在下方堆叠</button>
                                <button class="mini-button" @onclick='() => BeginStack(node, true)'>在上方堆叠</button>
                            </div>
                        }
                    </div>
                }

                @if (Store.Nodes.Count == 0)
                {
                    <div class="graph-empty">
                        左侧选一个素材，然后新建节点并导入，开始搭制作路径。
                    </div>

                    <button class="primary-button graph-create"
                            @onclick="CreateNode">
                        新建节点
                    </button>
                }
            </div>
        </section>
    </div>

    @if (!string.IsNullOrWhiteSpace(_dialogMessage))
    {
        <div class="dialog-mask">
            <div class="dialog-box">
                <h3>@_dialogTitle</h3>
                <p>@_dialogMessage</p>

                <div class="dialog-actions">
                    @if (_dialogConfirm is not null)
                    {
                        <button class="secondary-button" @onclick="CloseDialog">取消</button>
                        <button class="primary-button" @onclick="RunConfirm">确定</button>
                    }
                    else
                    {
                        <button class="primary-button" @onclick="CloseDialog">知道了</button>
                    }
                </div>
            </div>
        </div>
    }

</div>

@code {
    private const int CellWidth = 250;
    private const int CellHeight = 430;
    private const int NodeHeight = 340;
    private const int NodeWidth = 210;

    private CollapseMode _mode = CollapseMode.IncludeCycles;

    private WorkspaceItem? _selectedMaterial;

    private string _dialogTitle = "";

    private string _dialogMessage = "";

    private Action? _dialogConfirm;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;

        await Store.EnsureLoadedAsync();
        await Store.EnsureGraphLoadedAsync();
    }

    private void OnStoreChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
    }

    private int CanvasWidth =>
        (Store.Nodes.Count == 0 ? 1 : Store.Nodes.Max(node => node.Col) + 1) * CellWidth + 60;

    private int CanvasHeight =>
        (Store.Nodes.Count == 0 ? 1 : Store.Nodes.Max(node => node.Row) + 1) * CellHeight + 60;

    private string CanvasStyle =>
        $"width:{CanvasWidth}px;height:{CanvasHeight}px;";

    private string NodeStyle(WorkspaceNode node) =>
        $"left:{20 + node.Col * CellWidth}px;" +
        $"top:{20 + node.Row * CellHeight}px;" +
        $"width:{NodeWidth}px;";

    private static int NodeCenterX(WorkspaceNode node) =>
        20 + node.Col * CellWidth + NodeWidth / 2;

    private static int NodeBottom(WorkspaceNode node) =>
        20 + node.Row * CellHeight + NodeHeight;

    private static int NodeTop(WorkspaceNode node) =>
        20 + node.Row * CellHeight;

    private sealed record EdgeView(string Path, string Label, int LabelX, int LabelY);

    private List<EdgeView> EdgeViews
    {
        get
        {
            var views = new List<EdgeView>();

            foreach (WorkspaceEdge edge in Store.Edges)
            {
                WorkspaceNode? from = Store.FindNode(edge.FromId);
                WorkspaceNode? to = Store.FindNode(edge.ToId);

                if (from is null || to is null)
                {
                    continue;
                }

                int x1 = NodeCenterX(from);
                int y1 = NodeBottom(from);
                int x2 = NodeCenterX(to);
                int y2 = NodeTop(to);

                int midY = y1 + Math.Max(20, (y2 - y1) / 2);

                string path = $"M {x1} {y1} L {x1} {midY} L {x2} {midY} L {x2} {y2 - 4}";

                int labelX = Math.Clamp(x2, 70, CanvasWidth - 70);
                int labelY = y2 - 36;

                views.Add(new EdgeView(path, edge.Label, labelX, labelY));
            }

            return views;
        }
    }

    private string NodeTitle(WorkspaceNode node) =>
        node.Kind == "ref"
            ? "堆叠输入"
            : node.IsResult
                ? node.Label
                : "素材节点";

    private ShapeDocument? NodeDocument(WorkspaceNode node)
    {
        if (node.Kind == "ref")
        {
            WorkspaceNode? target = Store.FindNode(node.TargetId);

            return target is null
                ? Store.GetNodeDocument(node)
                : Store.GetNodeDocument(target);
        }

        return Store.GetNodeDocument(node);
    }

    private IEnumerable<WorkspaceNode> TargetCandidates(WorkspaceNode slot)
    {
        return Store.Nodes.Where(node =>
            node.Id != slot.Id &&
            node.Kind != "ref" &&
            node.HasShape);
    }

    private WorkspaceNode? ResolveSlot(WorkspaceNode slot) =>
        slot.TargetId is null ? null : Store.FindNode(slot.TargetId);

    private void CreateNode()
    {
        Store.CreateSourceNode(0, 0);
    }

    private void ImportMaterial(WorkspaceNode node)
    {
        if (_selectedMaterial is null)
        {
            ShowDialog("提示", "请先在左侧选择一个素材。");

            return;
        }

        ApplyImport(node, _selectedMaterial);
    }

    private void ImportMaterialIntoRef(WorkspaceNode slot)
    {
        if (_selectedMaterial is null)
        {
            return;
        }

        ApplyImport(slot, _selectedMaterial);
    }

    private void ApplyImport(WorkspaceNode node, WorkspaceItem material)
    {
        int downstream = Store.Downstream(node.Id).Count;

        if (downstream > 0)
        {
            ShowConfirm(
                "确认更换图形",
                $"该节点有 {downstream} 个下游结果，更换图形会一并删除，继续？",
                () => DoImport(node, material));

            return;
        }

        DoImport(node, material);
    }

    private void DoImport(WorkspaceNode node, WorkspaceItem material)
    {
        if (node.Kind == "ref")
        {
            Store.SetSlotShape(
                node.Id,
                material.Code,
                material.Format,
                material.Layers,
                material.Parts);

            return;
        }

        Store.ReplaceNodeShape(
            node.Id,
            material.Code,
            material.Format,
            material.Layers,
            material.Parts);
    }

    private void ReferenceSelected(WorkspaceNode slot)
    {
        WorkspaceNode? target = Store.SelectedNode;

        if (target is null || !target.HasShape || target.Id == slot.BaseId)
        {
            ShowDialog("提示", "请先在画布上点选一个已有图形的节点。");

            return;
        }

        Store.SetReferenceTarget(slot.Id, target.Id);
    }

    private void OnSelectTarget(WorkspaceNode slot, string? targetId)
    {
        if (string.IsNullOrWhiteSpace(targetId))
        {
            return;
        }

        Store.SetReferenceTarget(slot.Id, targetId);
    }

    private void BeginStack(WorkspaceNode node, bool currentIsTop)
    {
        if (!node.HasShape)
        {
            ShowDialog("提示", "该节点还没有图形。");

            return;
        }

        Store.BeginStack(node.Id, currentIsTop);
    }

    private void ComputeStack(WorkspaceNode slot)
    {
        NodeActionResult result = Store.ComputeStack(slot.Id, _mode);

        ShowDialog("堆叠", result.Message);
    }

    private void Apply(WorkspaceNode node, string operation)
    {
        if (!node.HasShape)
        {
            ShowDialog("提示", "该节点还没有图形。");

            return;
        }

        NodeActionResult result = operation switch
        {
            "pin" => Store.ApplyPin(node.Id, _mode),
            "cut" => Store.ApplyCut(node.Id, _mode),
            _ => Store.ApplyCollapse(node.Id, _mode)
        };

        if (!result.Created)
        {
            ShowDialog("提示", result.Message);
        }
    }

    private void ConfirmDelete(WorkspaceNode node)
    {
        int downstream = Store.Downstream(node.Id).Count;

        if (downstream == 0)
        {
            Store.DeleteNode(node.Id);

            return;
        }

        ShowConfirm(
            "删除节点",
            $"将删除该节点及其 {downstream} 个下游节点，继续？",
            () => Store.DeleteNode(node.Id));
    }

    private void ConfirmClear()
    {
        ShowConfirm(
            "清空画布",
            "将删除画布上的所有节点，素材列表不受影响。",
            () => Store.ClearGraph());
    }

    private Task ExportGraph()
    {
        ShowDialog("导出图片", "路径图导出正在接入，稍后可用。");

        return Task.CompletedTask;
    }

    private void ShowDialog(string title, string message)
    {
        _dialogTitle = title;
        _dialogMessage = message;
        _dialogConfirm = null;
    }

    private void ShowConfirm(string title, string message, Action confirm)
    {
        _dialogTitle = title;
        _dialogMessage = message;
        _dialogConfirm = confirm;
    }

    private void RunConfirm()
    {
        Action? action = _dialogConfirm;

        CloseDialog();
        action?.Invoke();
    }

    private void CloseDialog()
    {
        _dialogTitle = "";
        _dialogMessage = "";
        _dialogConfirm = null;
    }

    private string ModeClass(CollapseMode mode) =>
        _mode == mode ? "format-button active" : "format-button";
}
