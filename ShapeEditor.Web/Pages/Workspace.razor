@page "/workspace"

@using ShapeEditor.Core.Models
@using ShapeEditor.Core.Physics
@using ShapeEditor.Core.Workspaces
@using WorkspaceStore = ShapeEditor.Web.Services.WorkspaceStore
@using WorkspaceItem = ShapeEditor.Web.Models.WorkspaceItem
@using NodeActionResult = ShapeEditor.Web.Services.NodeActionResult
@using WorkspaceAddResult = ShapeEditor.Web.Services.WorkspaceAddResult
@using ShapeEditor.Core.Services
@using ShapeEditor.Web.Models
@using ShapeEditor.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject WorkspaceStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>图形工作区</PageTitle>

<SiteHeader Active="workspace" />

<div class="workspace-page">

            <header class="workspace-title">
        <h1>制作路径</h1>

                <div class="graph-legend">
            <span>图例：</span>
            <span class="legend-item"><b>c</b> 晶体</span>
            <span class="legend-item"><b>S</b> 普通形状</span>
            <span class="legend-item"><span class="legend-pin"></span> 顶针</span>
            <span class="legend-item"><span class="legend-empty"></span> 空位</span>
        </div>
        <div class="ws-tools">
            <button class="mini-button" disabled="@(Store.SelectedNode is null)"
                    @onclick='() => ApplyFromToolbar("collapse")'>下落</button>
            <button class="mini-button" disabled="@(Store.SelectedNode is null)"
                    @onclick='() => ApplyFromToolbar("pin")'>顶针</button>
            <button class="mini-button" disabled="@(Store.SelectedNode is null)"
                    @onclick='() => ApplyFromToolbar("cut")'>切割</button>

            <button class="mini-button" disabled="@(Store.SelectedNode is null)"
                    @onclick="BeginStackFromToolbar">堆叠</button>
        </div>
        @if (_stackHint is not null)
        {
            <div class="graph-hint">@_stackHint</div>
        }

        <div class="graph-hint">
            提示：点击连线上的操作文字可以调整标签位置；双击工作区标签可以重命名。
        </div>
    </header>

    <div class="workspace-body">

        <div class="ws-tabrow">
            <div class="ws-tabs">
                @foreach (WorkspaceProject project in Store.Projects)
                {
                    bool active = project.Id == Store.ActiveProject?.Id;

                    <div class="ws-tab @(active ? "active" : "")"
                         @onclick="() => Store.ActivateProject(project.Id)"
                         @ondblclick="() => BeginRename(project)">

                        @if (_renamingId == project.Id)
                        {
                            <input @ref="_renameInput"
                                   class="ws-tab-input"
                                   value="@project.Name"
                                   @oninput="e => _renameText = e.Value?.ToString() ?? string.Empty"
                                   @onclick:stopPropagation="true"
                                   @onblur="() => CommitRename(project)"
                                   @onkeydown="e => OnRenameKey(e, project)" />
                        }
                        else
                        {
                            <span>@project.Name</span>
                        }

                        @if (active)
                        {
                            <button class="ws-tab-close"
                                    title="删除该工作区"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => DeleteProject(project)">
                                ×
                            </button>
                        }
                    </div>
                }
            </div>

            <button class="ws-tab-add"
                    title="新建工作区"
                    @onclick="() => Store.CreateProject()">
                +
            </button>

            <div class="ws-tabrow-spacer"></div>

            <label class="mini-button file-button">
                导入工作区
                <InputFile OnChange="ImportWorkspace" accept=".json,application/json" />
            </label>
        </div>

        <div class="ws-tools">
            <div class="code-format">
                <button class="@ModeClass(CollapseMode.IncludeCycles)"
                        @onclick="() => SetMode(CollapseMode.IncludeCycles)">
                    含循环支撑
                </button>
                <button class="@ModeClass(CollapseMode.FloorOnly)"
                        @onclick="() => SetMode(CollapseMode.FloorOnly)">
                    仅地面
                </button>
            </div>

            <label class="workspace-field ws-inline-field">
                高度上限
                <input type="number"
                       min="4"
                       max="100"
                       value="@Store.MaxLayers"
                       @onchange="e => OnMaxLayersChanged(e.Value?.ToString())" />
            </label>

            <button class="secondary-button"
                    disabled="@(Store.Nodes.Count == 0)"
                    @onclick="ExportGraph">
                导出图片
            </button>

            <button class="secondary-button" @onclick="ExportWorkspace">
                导出工作区
            </button>

            <button class="secondary-button"
                    disabled="@(Store.Nodes.Count == 0)"
                    @onclick="ConfirmClear">
                清空画布
            </button>
        </div>

        <aside class="workspace-list">
            <div class="tool-title">素材</div>

            @if (Store.Items.Count == 0)
            {
                <div class="batch-hint">
                    空。到编辑器点「加入工作区」，或批量导入。
                </div>
            }

            @foreach (WorkspaceItem item in Store.Items)
            {
                <div class="ws-card @(_selectedMaterial?.Id == item.Id ? "selected" : "")"
                     draggable="true"
                     @ondragstart="() => _dragMaterialId = item.Id"
                     @ondblclick="() => CreateFromMaterial(item)"
                     @onclick="() => _selectedMaterial = item">

                    <div class="ws-thumb">
                        @if (Store.GetDocument(item, out _) is ShapeDocument document)
                        {
                            <ShapePreview Document="document" CssClass="ws-preview" />
                        }
                    </div>

                    <div class="ws-info">
                        <div class="ws-name-plain">@item.Name</div>
                        <div class="ws-meta">@item.DimensionText</div>
                    </div>
                </div>
            }
        </aside>

        <section class="graph-canvas-wrapper">
            <div class="graph-canvas" style="@CanvasStyle"
             @ondragover="OnDragOver"
             @ondragover:preventDefault
             @ondrop="OnCanvasDrop"
             @onpointermove="OnDragMove"
             @onpointerup="EndDrag"
             @onpointerleave="EndDrag">

                <svg class="graph-arrows" width="@CanvasWidth" height="@CanvasHeight">
                    @foreach (EdgeView edge in EdgeViews)
                    {
                        <path d="@edge.Path"
                              data-edge-from="@edge.FromId"
                              data-edge-to="@edge.ToId"
                              fill="none"
                              stroke="#512bd4"
                              stroke-width="2" />

                        <polygon points="@edge.Arrow"
                                 data-edge-from="@edge.FromId"
                                 data-edge-to="@edge.ToId"
                                 fill="#512bd4" />
                    }
                </svg>

                @foreach (EdgeView edge in EdgeViews)
                {
                    
                }

                @foreach (WorkspaceNode node in Store.Nodes)
                {
                    <div class="graph-node @(node.IsResult ? "result" : "") @(node.Kind == "ref" ? "ref" : "") @(Store.SelectedNode?.Id == node.Id ? "selected" : "")"
                         data-node-id="@node.Id"
                         style="@NodeStyle(node)"
                         @onpointerdown="e => BeginDrag(node, e)"
                         @onclick="() => OnNodeClick(node)">

                        <div class="graph-node-head">
                            <span class="graph-node-title">#@node.Seq · @NodeTitle(node)</span>

                            <button class="node-delete"
                                    title="删除该节点及其下游"
                                    @onclick="() => ConfirmDelete(node)">
                                ×
                            </button>
                        </div>

                        <div class="graph-node-body">
                            @if (NodeDocument(node) is ShapeDocument document)
                            {
                                <div class="ws-preview-scroll @(document.LayerCount > 20 ? "scrollable" : "fixed")"
                                     style="height:@(Math.Min(document.LayerCount, 20) * 20 + 4)px">
                                    <ShapePreview Document="document" CssClass="graph-preview" />
                                </div>
                            }
                            else if (node.Kind == "ref")
                            {
                                <span class="ws-slot-empty">选择输入</span>
                            }
                            else
                            {
                                <span class="ws-slot-empty">空</span>
                            }
                        </div>

                    </div>
                }

                @if (Store.Nodes.Count == 0)
                {
                    <div class="graph-empty">
                        把左侧素材拖进来，或双击素材，开始搭制作路径。
                    </div>

                    }
            </div>
        </section>
    </div>

    @if (!string.IsNullOrWhiteSpace(_dialogMessage))
    {
        <div class="dialog-mask">
            <div class="dialog-box">
                <h3>@_dialogTitle</h3>
                <p>@_dialogMessage</p>

                <div class="dialog-actions">
                    @if (_dialogConfirm is not null)
                    {
                        <button class="secondary-button" @onclick="CloseDialog">取消</button>
                        <button class="primary-button" @onclick="RunConfirm">确定</button>
                    }
                    else
                    {
                        <button class="primary-button" @onclick="CloseDialog">知道了</button>
                    }
                </div>
            </div>
        </div>
    }

</div>

@code {
    private const int CellWidth = 250;
    private const int CellHeight = 400;
    private const int NodeHeight = 280;
    private const int NodeWidth = 260;

    private WorkspaceItem? _selectedMaterial;

    private string? _renamingId;

    private string _renameText = "";

    private ElementReference _renameInput;

    private string _dialogTitle = "";

    private string _dialogMessage = "";

    private Action? _dialogConfirm;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;

        await Store.EnsureLoadedAsync();
        await Store.EnsureGraphLoadedAsync();
    }

    private void OnStoreChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
    }

    private int CanvasWidth =>
        Quantize(Math.Max(
            1200,
            Store.Nodes.Count == 0
                ? 0
                : Store.Nodes.Max(node => NodeX(node)) + NodeWidth + 400));

    private int CanvasHeight =>
        Quantize(Math.Max(
            800,
            Store.Nodes.Count == 0
                ? 0
                : Store.Nodes.Max(node => NodeY(node)) + NodeHeight + 400));

    private static int Quantize(double value) =>
        (int)(Math.Ceiling(value / 200) * 200);

    private string CanvasStyle =>
        $"width:{CanvasWidth}px;height:{CanvasHeight}px;";

    private string NodeStyle(WorkspaceNode node) =>
        $"left:{NodeX(node)}px;" +
        $"top:{NodeY(node)}px;" +
        $"width:{NodeWidth}px;";

    private static int NodeCenterX(WorkspaceNode node) =>
        20 + node.Col * CellWidth + NodeWidth / 2;

    private static int NodeBottom(WorkspaceNode node) =>
        20 + node.Row * CellHeight + NodeHeight;

    private static int NodeTop(WorkspaceNode node) =>
        20 + node.Row * CellHeight;

    private async Task ApplyFromToolbar(string operation)
    {
        WorkspaceNode? source = Store.SelectedNode;

        if (source is null)
        {
            return;
        }

        NodeActionResult result = operation switch
        {
            "pin" => Store.ApplyPin(source.Id, Store.Mode),
            "cut" => Store.ApplyCut(source.Id, Store.Mode),
            _ => Store.ApplyCollapse(source.Id, Store.Mode)
        };

        if (result.Node is not null)
        {
            double gap = NodeHeight + 56;
            double below = NodeY(source) + gap;

            if (operation == "cut")
            {
                // 切割：东在左、西在右，对称排在下方
                WorkspaceNode? east = Store.Nodes.FirstOrDefault(
                    node => node.OpKey == $"cutw:{source.Id}");

                WorkspaceNode? west = Store.Nodes.FirstOrDefault(
                    node => node.OpKey == $"cute:{source.Id}");

                if (east is not null)
                {
                    Store.SetNodePosition(east.Id, Math.Max(20, NodeX(source) - 260), below);
                }

                if (west is not null)
                {
                    Store.SetNodePosition(west.Id, NodeX(source) + 260, below);
                }
            }
            else
            {
                // 下落 / 顶针：放在正下方
                Store.SetNodePosition(result.Node.Id, NodeX(source), below);
            }

            Store.SelectNode(result.Node);
        }
        else if (!result.Created)
        {
            ShowDialog("提示", result.Message);
        }

        await Task.CompletedTask;
    }

    private string? _clipCode;

    private ShortCodeFormat _clipFormat = ShortCodeFormat.Full;

    private int _clipLayers;

    private int _clipParts;

    private void CopySelected()
    {
        if (Store.SelectedNode is not WorkspaceNode node ||
            NodeDocument(node) is not ShapeDocument document)
        {
            return;
        }

        _clipCode = new ShapeEditor.Core.Services.ShortCodeExporter()
            .Export(document, omitTopEmptyLayers: true);

        _clipFormat = ShortCodeFormat.Full;
        _clipLayers = document.LayerCount;
        _clipParts = document.PartCount;
    }

    private void PasteClipboard()
    {
        if (_clipCode is null || !Store.PartsAllowed(_clipParts))
        {
            return;
        }

        WorkspaceNode node = Store.CreateNodeAtPoint(80, 80);

        Store.ReplaceNodeShape(node.Id, _clipCode, _clipFormat, _clipLayers, _clipParts);
    }

    private void DeleteSelected()
    {
        if (Store.SelectedNode is WorkspaceNode node)
        {
            Store.DeleteNode(node.Id);
        }
    }

    private string? _stackBaseId;

    private string? _stackHint;

    private void BeginStackFromToolbar()
    {
        if (Store.SelectedNode is null)
        {
            return;
        }

        _stackBaseId = Store.SelectedNode.Id;
        _stackHint = "再点一个节点或素材作为第二个输入（Esc 取消）";
    }

    private void OnNodeClick(WorkspaceNode node)
    {
        if (_stackBaseId is not null && node.Id != _stackBaseId)
        {
            NodeActionResult result = Store.ComputeStackOf(_stackBaseId, node.Id, baseIsTop: true, Store.Mode);

            _stackBaseId = null;
            _stackHint = null;

            if (result.Node is not null)
            {
                Store.SetNodePosition(
                    result.Node.Id,
                    NodeX(node) + NodeWidth + 80,
                    NodeY(node));
            }
            else if (!result.Created)
            {
                ShowDialog("提示", result.Message);
            }

            return;
        }

        Store.SelectNode(node);
    }

    private readonly Dictionary<string, double> _measuredHeight = new();

    private bool _measuring;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_measuring)
        {
            return;
        }

        _measuring = true;

        try
        {
            var items = await JS.InvokeAsync<List<MeasuredNode>>("shapeGridMeasureNodes");

            bool changed = false;

            foreach (MeasuredNode item in items)
            {
                if (item.Height <= 0)
                {
                    continue;
                }

                if (!_measuredHeight.TryGetValue(item.Id, out double current) ||
                    Math.Abs(current - item.Height) > 0.5)
                {
                    _measuredHeight[item.Id] = item.Height;
                    changed = true;
                }
            }

            if (changed)
            {
                await InvokeAsync(StateHasChanged);
            }

            await JS.InvokeVoidAsync("shapeGridLayoutEdges");
        }
        catch
        {
        }
        finally
        {
            _measuring = false;
        }
    }

    private sealed class MeasuredNode
    {
        public string Id { get; set; } = "";

        public double Height { get; set; }

        public double Width { get; set; }
    }

    private string? _dragMaterialId;

    private string? _dragId;

    private void CreateFromMaterial(WorkspaceItem material)
    {
        WorkspaceNode node = Store.CreateNodeAtPoint(60, 60);

        Store.ReplaceNodeShape(node.Id, material.Code, material.Format, material.Layers, material.Parts);

        if (Store.LastError is not null)
        {
            ShowDialog("无法添加", Store.LastError);
        }
    }

    private void CancelStack()
    {
        _stackBaseId = null;
        _stackHint = null;
    }

    private void OnDragOver()
    {
    }

    private void OnCanvasDrop(DragEventArgs e)
    {
        if (_dragMaterialId is null)
        {
            return;
        }

        WorkspaceItem? material = Store.Items.FirstOrDefault(item => item.Id == _dragMaterialId);

        _dragMaterialId = null;

        if (material is null)
        {
            return;
        }

        WorkspaceNode node = Store.CreateNodeAtPoint(
            Math.Max(20, e.OffsetX - NodeWidth / 2),
            Math.Max(20, e.OffsetY - 30));

        Store.ReplaceNodeShape(node.Id, material.Code, material.Format, material.Layers, material.Parts);

        if (Store.LastError is not null)
        {
            ShowDialog("无法添加", Store.LastError);
        }
    }

    private double _dragStartX;
    private double _dragStartY;
    private double _nodeStartX;
    private double _nodeStartY;

    private void BeginDrag(
        WorkspaceNode node,
        PointerEventArgs e)
    {
        _dragId = node.Id;
        _dragStartX = e.ClientX;
        _dragStartY = e.ClientY;
        _nodeStartX = NodeX(node);
        _nodeStartY = NodeY(node);
    }

    private void OnDragMove(
        PointerEventArgs e)
    {
        if (_dragId is null)
        {
            return;
        }

        WorkspaceNode? node = Store.FindNode(_dragId);

        if (node is null)
        {
            return;
        }

        node.X = Math.Round((_nodeStartX + e.ClientX - _dragStartX) / 10) * 10;
        node.Y = Math.Round((_nodeStartY + e.ClientY - _dragStartY) / 10) * 10;

        StateHasChanged();
    }

    private void EndDrag(
        PointerEventArgs e)
    {
        if (_dragId is null)
        {
            return;
        }

        WorkspaceNode? node = Store.FindNode(_dragId);

        _dragId = null;

        if (node is not null)
        {
            Store.SetNodePosition(node.Id, node.X ?? 0, node.Y ?? 0);
        }
    }

    /// <summary>
    /// 计算矩形边界上朝向另一节点的锚点。
    /// </summary>
    /// <summary>节点实际高度：标题 + 最多 20 行预览。</summary>
    private double NodeHeightOf(WorkspaceNode node)
    {
        int rows = 6;

        if (NodeDocument(node) is ShapeDocument document)
        {
            rows = Math.Min(Math.Max(document.LayerCount, 1), 20);
        }

        if (_measuredHeight.TryGetValue(node.Id, out double measured) && measured > 20)
        {
            return measured;
        }

        return 54 + rows * 20;
    }
    private (double X, double Y) EdgeAnchor(
        WorkspaceNode node,
        WorkspaceNode other)
    {
        double cx = NodeX(node) + NodeWidth / 2;
        double cy = NodeY(node) + NodeHeightOf(node) / 2;

        double ox = NodeX(other) + NodeWidth / 2;
        double oy = NodeY(other) + NodeHeightOf(other) / 2;

        double dx = ox - cx;
        double dy = oy - cy;
        double length = Math.Sqrt(dx * dx + dy * dy);

        if (length < 1)
        {
            return (cx, cy + NodeHeightOf(node) / 2);
        }

        dx /= length;
        dy /= length;

        double halfWidth = NodeWidth / 2;
        double halfHeight = NodeHeightOf(node) / 2;

        double scaleX = Math.Abs(dx) < 1e-6 ? double.MaxValue : halfWidth / Math.Abs(dx);
        double scaleY = Math.Abs(dy) < 1e-6 ? double.MaxValue : halfHeight / Math.Abs(dy);

        double scale = Math.Min(scaleX, scaleY);

        return (cx + dx * scale, cy + dy * scale);
    }

    private double NodeX(WorkspaceNode node) =>
        node.X ?? (20 + node.Col * CellWidth);

    private double NodeY(WorkspaceNode node) =>
        node.Y ?? (20 + node.Row * CellHeight);

    private sealed record EdgeView(
        string FromId,
        string ToId,
        string Path,
        string Arrow,
        string Label,
        int LabelX,
        int LabelY);

    private List<EdgeView> EdgeViews
    {
        get
        {
            var views = new List<EdgeView>();

            List<WorkspaceEdge> edges = Store.Edges.ToList();

            // 每个节点的出入边序号，用来把主干错开，避免多条线重叠
            var outgoing = edges
                .GroupBy(edge => edge.FromId)
                .ToDictionary(group => group.Key, group => group.ToList());

            var incoming = edges
                .GroupBy(edge => edge.ToId)
                .ToDictionary(group => group.Key, group => group.ToList());

            foreach (WorkspaceEdge edge in edges)
            {
                WorkspaceNode? from = Store.FindNode(edge.FromId);
                WorkspaceNode? to = Store.FindNode(edge.ToId);

                if (from is null || to is null)
                {
                    continue;
                }

                int outIndex = outgoing[edge.FromId].IndexOf(edge);
                int outCount = outgoing[edge.FromId].Count;

                int inIndex = incoming[edge.ToId].IndexOf(edge);
                int inCount = incoming[edge.ToId].Count;

                // 锚点取“中心连心线”与矩形边界的交点，箭头始终指向对方中心
                (double ax1, double ay1) = EdgeAnchor(from, to);
                (double ax2, double ay2) = EdgeAnchor(to, from);

                double vx = ax2 - ax1;
                double vy = ay2 - ay1;
                double vlen = Math.Sqrt(vx * vx + vy * vy);

                if (vlen < 1)
                {
                    vlen = 1;
                }

                double px = -vy / vlen;
                double py = vx / vlen;

                double outOffset = Spread(outIndex, outCount, 30);
                double inOffset = Spread(inIndex, inCount, 30);

                double x1 = ax1 + px * outOffset;
                double y1 = ay1 + py * outOffset;
                double x2 = ax2 + px * inOffset;
                double y2 = ay2 + py * inOffset;

                double ux = x2 - x1;
                double uy = y2 - y1;
                double ulen = Math.Sqrt(ux * ux + uy * uy);

                if (ulen > 20)
                {
                    x2 -= ux / ulen * 3;
                    y2 -= uy / ulen * 3;
                }

                // 折线走在“父节点底部到子节点顶部”的空档里，
                // 每条边占一条独立车道，标签压在车道上方
                // 直接斜线连到目标，箭头在终点按角度旋转
                string path =
                    $"M {x1} {y1} L {x2} {y2 - 4}";

                // 标签按比例落在线上，再沿法线推到线的一侧，
                // 点击标签可以在 0.5 / 0.75 / 0.25 之间轮换
                double t = Math.Clamp(edge.LabelT, 0.1, 0.9);

                double dx = x2 - x1;
                double dy = y2 - y1;

                double length = Math.Sqrt(dx * dx + dy * dy);

                if (length < 1)
                {
                    length = 1;
                }

                double nx = -dy / length;
                double ny = dx / length;

                if (ny > 0)
                {
                    nx = -nx;
                    ny = -ny;
                }

                if (Math.Abs(dx) < 8)
                {
                    nx = 1;
                    ny = 0;
                }

                double offset = Math.Abs(dx) < 8 ? 42 : 18;

                int labelX = (int)Math.Round(x1 + dx * t + nx * offset);
                int labelY = (int)Math.Round(y1 + dy * t + ny * offset);

                labelX = Math.Clamp(labelX, 70, CanvasWidth - 70);

                double alen = Math.Sqrt(ux * ux + uy * uy);

                double uxN = alen < 1 ? 0 : ux / alen;
                double uyN = alen < 1 ? 1 : uy / alen;

                const double head = 11;
                const double half = 5;

                double bx = x2 - uxN * head;
                double by = y2 - uyN * head;

                string arrow =
                    $"{x2:0.#},{y2:0.#} " +
                    $"{bx - uyN * half:0.#},{by + uxN * half:0.#} " +
                    $"{bx + uyN * half:0.#},{by - uxN * half:0.#}";

                views.Add(new EdgeView(
                    edge.FromId,
                    edge.ToId,
                    path,
                    arrow,
                    edge.Label,
                    labelX,
                    labelY));
            }

            return views;
        }
    }

    private static int Spread(int index, int count, int step)
    {
        if (count <= 1)
        {
            return 0;
        }

        double centered = index - (count - 1) / 2.0;

        return (int)Math.Round(centered * step);
    }

    private string NodeTitle(WorkspaceNode node) =>
        node.Kind == "ref"
            ? "堆叠输入"
            : node.IsResult
                ? node.Label
                : "素材节点";

    private ShapeDocument? NodeDocument(WorkspaceNode node)
    {
        if (node.Kind == "ref")
        {
            WorkspaceNode? target = Store.FindNode(node.TargetId);

            return target is null
                ? Store.GetNodeDocument(node)
                : Store.GetNodeDocument(target);
        }

        return Store.GetNodeDocument(node);
    }

    private IEnumerable<WorkspaceNode> TargetCandidates(WorkspaceNode slot)
    {
        return Store.Nodes.Where(node =>
            node.Id != slot.Id &&
            node.Kind != "ref" &&
            node.HasShape);
    }

    /// <summary>
    /// 堆叠槽位是否已有可用输入：引用了别的节点，或者直接导入了素材。
    /// </summary>
    private bool SlotReady(WorkspaceNode slot) =>
        ResolveSlot(slot) is not null || slot.HasShape;

    /// <summary>
    /// 当前选中的节点能否作为该槽位的引用目标。
    /// </summary>
    private bool CanReference(WorkspaceNode slot)
    {
        WorkspaceNode? target = Store.SelectedNode;

        return target is not null &&
               target.HasShape &&
               target.Kind != "ref" &&
               target.Id != slot.Id &&
               target.Id != slot.BaseId;
    }

    private WorkspaceNode? ResolveSlot(WorkspaceNode slot) =>
        slot.TargetId is null ? null : Store.FindNode(slot.TargetId);

    private void CreateNode()
    {
        Store.CreateSourceNode(0, 0);
    }

    private void ImportMaterial(WorkspaceNode node)
    {
        if (_selectedMaterial is null)
        {
            ShowDialog("提示", "请先在左侧选择一个素材。");

            return;
        }

        ApplyImport(node, _selectedMaterial);
    }

    private void ImportMaterialIntoRef(WorkspaceNode slot)
    {
        if (_selectedMaterial is null)
        {
            return;
        }

        ApplyImport(slot, _selectedMaterial);
    }

    private void ApplyImport(WorkspaceNode node, WorkspaceItem material)
    {
        int downstream = Store.Downstream(node.Id).Count;

        if (downstream > 0)
        {
            ShowConfirm(
                "确认更换图形",
                $"该节点有 {downstream} 个下游结果，更换图形会一并删除，继续？",
                () => DoImport(node, material));

            return;
        }

        DoImport(node, material);
    }

    private void DoImport(WorkspaceNode node, WorkspaceItem material)
    {
        /*
         * 导入画布上的第一个图形时，把全局高度上限对齐到它的层数，
         * 避免默认 100 层把结果撑得很高。
         */
        bool isFirstShape = !Store.Nodes.Any(entry => entry.HasShape);

        if (isFirstShape)
        {
            Store.SetMaxLayers(material.Layers);
        }

        if (node.Kind == "ref")
        {
            Store.SetSlotShape(
                node.Id,
                material.Code,
                material.Format,
                material.Layers,
                material.Parts);

            return;
        }

        Store.ReplaceNodeShape(
            node.Id,
            material.Code,
            material.Format,
            material.Layers,
            material.Parts);
    }

    private void ReferenceSelected(WorkspaceNode slot)
    {
        if (!CanReference(slot))
        {
            ShowDialog("提示", "请点选一个其它节点（不能引用自己、引用槽位或堆叠底节点）。");

            return;
        }

        Store.SetReferenceTarget(slot.Id, Store.SelectedNode!.Id);
    }

    private void OnSelectTarget(WorkspaceNode slot, string? targetId)
    {
        if (string.IsNullOrWhiteSpace(targetId))
        {
            return;
        }

        Store.SetReferenceTarget(slot.Id, targetId);
    }

    private void BeginStack(WorkspaceNode node, bool currentIsTop)
    {
        if (!node.HasShape)
        {
            ShowDialog("提示", "该节点还没有图形。");

            return;
        }

        Store.BeginStack(node.Id, currentIsTop);
    }

    private void ComputeStack(WorkspaceNode slot)
    {
        NodeActionResult result = Store.ComputeStack(slot.Id, Store.Mode);

        ShowDialog("堆叠", result.Message);
    }

    private void Apply(WorkspaceNode node, string operation)
    {
        if (!node.HasShape)
        {
            ShowDialog("提示", "该节点还没有图形。");

            return;
        }

        NodeActionResult result = operation switch
        {
            "pin" => Store.ApplyPin(node.Id, Store.Mode),
            "cut" => Store.ApplyCut(node.Id, Store.Mode),
            _ => Store.ApplyCollapse(node.Id, Store.Mode)
        };

        if (!result.Created)
        {
            ShowDialog("提示", result.Message);
        }
    }

    private void ConfirmDelete(WorkspaceNode node)
    {
        int downstream = Store.Downstream(node.Id).Count;

        if (downstream == 0)
        {
            Store.DeleteNode(node.Id);

            return;
        }

        ShowConfirm(
            "删除节点",
            $"将删除该节点及其 {downstream} 个下游节点，继续？",
            () => Store.DeleteNode(node.Id));
    }

    private void ConfirmClear()
    {
        ShowConfirm(
            "清空画布",
            "将删除画布上的所有节点，素材列表不受影响。",
            () => Store.ClearGraph());
    }

    private async Task ExportGraph()
    {
        if (Store.Nodes.Count == 0)
        {
            return;
        }

        var payload = new GraphExportPayload();

        foreach (WorkspaceNode node in Store.Nodes)
        {
            payload.Nodes.Add(new GraphExportNode
            {
                Id = node.Id,
                Seq = node.Seq,
                Row = node.Row,
                Col = node.Col,
                X = NodeX(node),
                Y = NodeY(node),
                Label = NodeTitle(node),
                IsResult = node.IsResult,
                IsRef = node.Kind == "ref",
                RefText = node.TargetId is not null &&
                          Store.FindNode(node.TargetId) is WorkspaceNode reference
                    ? $"引用 #{reference.Seq}"
                    : "",
                State = NodeDocument(node) is ShapeDocument document
                    ? ShapeCanvasState.Create(document)
                    : null
            });
        }

        foreach (WorkspaceEdge edge in Store.Edges)
        {
            if (Store.FindNode(edge.FromId) is null ||
                Store.FindNode(edge.ToId) is null)
            {
                continue;
            }

            payload.Edges.Add(new GraphExportEdge
            {
                From = edge.FromId,
                To = edge.ToId,
                Label = "",
                LabelT = edge.LabelT
            });
        }

        try
        {
            await JS.InvokeVoidAsync(
                "shapeGrid.downloadGraph",
                payload,
                $"shape-path-{DateTime.Now:yyyyMMdd-HHmmss}.png");
        }
        catch (Exception exception)
        {
            ShowDialog("导出失败", exception.Message);
        }
    }

    private void ShowDialog(string title, string message)
    {
        _dialogTitle = title;
        _dialogMessage = message;
        _dialogConfirm = null;
    }

    private void ShowConfirm(string title, string message, Action confirm)
    {
        _dialogTitle = title;
        _dialogMessage = message;
        _dialogConfirm = confirm;
    }

    private void RunConfirm()
    {
        Action? action = _dialogConfirm;

        CloseDialog();
        action?.Invoke();
    }

    private void CloseDialog()
    {
        _dialogTitle = "";
        _dialogMessage = "";
        _dialogConfirm = null;
    }

    private async Task BeginRename(WorkspaceProject project)
    {
        _renamingId = project.Id;
        _renameText = project.Name;

        StateHasChanged();

        await Task.Delay(20);

        try
        {
            await JS.InvokeVoidAsync("shapeUi.focus", _renameInput);
        }
        catch
        {
        }
    }

    private void CommitRename(WorkspaceProject project)
    {
        if (_renamingId != project.Id)
        {
            return;
        }

        _renamingId = null;

        if (string.IsNullOrWhiteSpace(_renameText))
        {
            return;
        }

        Store.RenameProject(project.Id, _renameText);
    }

    private void OnRenameKey(KeyboardEventArgs e, WorkspaceProject project)
    {
        if (e.Key == "Enter")
        {
            CommitRename(project);

            StateHasChanged();
        }
        else if (e.Key == "Escape")
        {
            _renamingId = null;

            StateHasChanged();
        }
    }

    private void DeleteProject(WorkspaceProject project)
    {
        ShowConfirm(
            "删除工作区",
            $"将删除工作区「{project.Name}」及其中的全部节点，素材列表不受影响。",
            () => Store.DeleteProject(project.Id));
    }

    private async Task ExportWorkspace()
    {
        string json = Store.ExportActiveProject();

        await JS.InvokeVoidAsync(
            "shapeStorage.downloadText",
            $"workspace-{DateTime.Now:yyyyMMdd-HHmmss}.json",
            json,
            "application/json;charset=utf-8");
    }

    private async Task ImportWorkspace(InputFileChangeEventArgs e)
    {
        try
        {
            await using Stream stream = e.File.OpenReadStream(5 * 1024 * 1024);

            using var reader = new StreamReader(stream);

            string json = await reader.ReadToEndAsync();

            if (!Store.ImportProject(json, out string? error))
            {
                ShowDialog("导入失败", error ?? "未知错误。");
            }
        }
        catch (Exception exception)
        {
            ShowDialog("导入失败", exception.Message);
        }
    }

    private void OnMaxLayersChanged(string? value)
    {
        if (!int.TryParse(value, out int layers))
        {
            return;
        }

        Store.SetMaxLayers(layers);

        (int updated, int failed) = Store.RecomputeAll(Store.Mode);

        if (failed > 0)
        {
            ShowDialog(
                "重新计算",
                $"已按新上限重算 {updated} 个节点，{failed} 个节点因输入缺失被跳过。");
        }
    }

    private void SetMode(CollapseMode mode)
    {
        if (Store.Mode == mode)
        {
            return;
        }

        Store.SetMode(mode);

        (int updated, int failed) = Store.RecomputeAll(Store.Mode);

        if (failed > 0)
        {
            ShowDialog(
                "重新计算",
                $"已按新规则重算 {updated} 个节点，{failed} 个节点因输入缺失被跳过。");
        }
    }

    private string ModeClass(CollapseMode mode) =>
        Store.Mode == mode ? "format-button active" : "format-button";
}
