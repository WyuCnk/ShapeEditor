@page "/workspace"

@using ShapeEditor.Core.Models
@using ShapeEditor.Core.Physics
@using ShapeEditor.Core.Services
@using ShapeEditor.Web.Models
@using ShapeEditor.Web.Services
@implements IDisposable
@inject WorkspaceStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>图形工作区</PageTitle>

<SiteHeader Active="workspace" />

<div class="workspace-page">

    <header class="editor-header">
        <h1>图形工作区</h1>

        <div class="header-actions">
            <span class="batch-hint">@Store.Items.Count / @WorkspaceStore.MaxItems</span>

            <button class="secondary-button"
                    disabled="@(Store.Items.Count == 0)"
                    @onclick="ClearAll">
                清空
            </button>
        </div>
    </header>

    <div class="workspace-body">

        <!-- 左：窄列表 -->
        <aside class="workspace-list">

            @if (Store.Items.Count == 0)
            {
                <div class="batch-empty">
                    工作区是空的。到编辑器点「加入工作区」，或在批量查看里导入。
                </div>
            }

            @foreach (WorkspaceItem item in Store.Items)
            {
                <div class="ws-card @(_selectedId == item.Id ? "selected" : "")"
                     @onclick="() => Select(item)">

                    <div class="ws-thumb">
                        @if (GetDocument(item) is ShapeDocument document)
                        {
                            <ShapePreview Document="document" CssClass="ws-preview" />
                        }
                        else
                        {
                            <span class="batch-thumb-error">失败</span>
                        }
                    </div>

                    <div class="ws-info">
                        <input class="ws-name"
                               value="@item.Name"
                               title="点击可重命名"
                               @onclick:stopPropagation="true"
                               @onchange="e => Rename(item, e.Value?.ToString())" />

                        <div class="ws-meta">@item.DimensionText · @item.SourceText</div>
                    </div>

                    <div class="ws-actions">
                        <button class="mini-button"
                                @onclick:stopPropagation="true"
                                @onclick="() => LoadIntoEditor(item)">
                            编辑
                        </button>

                        <button class="mini-button danger"
                                @onclick:stopPropagation="true"
                                @onclick="() => Store.Remove(item.Id)">
                            删除
                        </button>
                    </div>
                </div>
            }

        </aside>

        <!-- 右：操作区 -->
        <section class="workspace-work">

            <div class="mode-tabs">
                <button class="@OperationClass("collapse")" @onclick='() => SetOperation("collapse")'>下落</button>
                <button class="@OperationClass("stack")" @onclick='() => SetOperation("stack")'>堆叠</button>
                <button class="@OperationClass("pin")" @onclick='() => SetOperation("pin")'>顶针</button>
                <button class="@OperationClass("cut")" @onclick='() => SetOperation("cut")'>切割</button>
            </div>

            <div class="ws-slots">

                <div class="ws-slot">
                    <div class="ws-slot-title">@(_operation == "stack" ? "下方图形" : "图形")</div>

                    <div class="ws-slot-body">
                        @if (FindSlot(_slotA) is WorkspaceItem itemA &&
                             GetDocument(itemA) is ShapeDocument documentA)
                        {
                            <ShapePreview Document="documentA" CssClass="ws-slot-preview" />
                            <span class="batch-hint">@itemA.DimensionText</span>
                        }
                        else
                        {
                            <span class="ws-slot-empty">空</span>
                        }
                    </div>

                    <div class="ws-slot-actions">
                        <button class="secondary-button" @onclick="() => AssignSlot(false)">
                            导入所选
                        </button>

                        @if (_slotA is not null)
                        {
                            <button class="mini-button" @onclick="() => ClearSlot(false)">清空</button>
                        }
                    </div>
                </div>

                @if (_operation == "stack")
                {
                    <div class="ws-slot">
                        <div class="ws-slot-title">上方图形</div>

                        <div class="ws-slot-body">
                            @if (FindSlot(_slotB) is WorkspaceItem itemB &&
                                 GetDocument(itemB) is ShapeDocument documentB)
                            {
                                <ShapePreview Document="documentB" CssClass="ws-slot-preview" />
                                <span class="batch-hint">@itemB.DimensionText</span>
                            }
                            else
                            {
                                <span class="ws-slot-empty">空</span>
                            }
                        </div>

                        <div class="ws-slot-actions">
                            <button class="secondary-button" @onclick="() => AssignSlot(true)">
                                导入所选
                            </button>

                            @if (_slotB is not null)
                            {
                                <button class="mini-button" @onclick="() => ClearSlot(true)">清空</button>
                            }
                        </div>
                    </div>
                }

            </div>

            <div class="ws-params">
                <div class="code-format">
                    <button class="@ModeClass(CollapseMode.IncludeCycles)"
                            @onclick="() => SetMode(CollapseMode.IncludeCycles)">
                        含循环支撑
                    </button>
                    <button class="@ModeClass(CollapseMode.FloorOnly)"
                            @onclick="() => SetMode(CollapseMode.FloorOnly)">
                        仅地面
                    </button>
                </div>

                @if (_operation == "stack")
                {
                    <label class="workspace-field ws-inline-field">
                        层数上限
                        <input type="number"
                               min="1"
                               max="100"
                               @bind="_heightLimit" />
                    </label>
                }
                else if (_operation == "pin")
                {
                    <span class="batch-hint">顶针使用该图形自身层数作为上限。</span>
                }
                else if (_operation == "cut")
                {
                    <span class="batch-hint">沿中线分成东西两半，两半都会输出。</span>
                }

                <button class="primary-button" @onclick="Compute">计算</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="error-message">@_error</div>
            }

            @if (_west is not null && _east is not null)
            {
                <div class="workspace-result">
                    <div class="tool-title">切割结果</div>

                    <div class="ws-result-pair">
                        <div class="ws-result-block">
                            <span class="batch-hint">西半</span>
                            <ShapePreview Document="_west" CssClass="ws-result-preview" />
                            <button class="secondary-button" @onclick='() => AddResult(_west, "cut")'>
                                加入工作区
                            </button>
                        </div>

                        <div class="ws-result-block">
                            <span class="batch-hint">东半</span>
                            <ShapePreview Document="_east" CssClass="ws-result-preview" />
                            <button class="secondary-button" @onclick='() => AddResult(_east, "cut")'>
                                加入工作区
                            </button>
                        </div>
                    </div>

                    <button class="secondary-button"
                            @onclick="ExportImage"
                            title="把输入与切割产物拼成一张图导出"
                            style="margin-top:10px;">
                        导出图片
                    </button>
                </div>
            }
            else if (_result is not null)
            {
                <div class="workspace-result">
                    <div class="tool-title">结果</div>

                    <ShapePreview Document="_result" CssClass="ws-result-preview" />

                    <p class="batch-hint">
                        @_result.LayerCount 层 × @_result.PartCount 象限
                    </p>

                    <div class="ws-result-actions">
                        <button class="primary-button"
                                @onclick="() => AddResult(_result, _operation)">
                            加入工作区
                        </button>

                        <button class="secondary-button"
                                @onclick="ExportImage"
                                title="把输入与产物拼成一张图导出">
                            导出图片
                        </button>
                    </div>
                </div>
            }

        </section>

    </div>

    @if (!string.IsNullOrWhiteSpace(_toast))
    {
        <div class="toast">@_toast</div>
    }

</div>

@code {
    private readonly ShortCodeExporter Exporter = new();

    private string _operation = "collapse";

    private CollapseMode _mode = CollapseMode.IncludeCycles;

    private string? _selectedId;

    private string? _slotA;

    private string? _slotB;

    private int _heightLimit = 4;

    private ShapeDocument? _result;

    private ShapeDocument? _west;

    private ShapeDocument? _east;

    private string _error = "";

    private string _toast = "";

    private CancellationTokenSource? _toastSource;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;

        await Store.EnsureLoadedAsync();
    }

    private void OnStoreChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;

        _toastSource?.Cancel();
    }

    private void Select(WorkspaceItem item)
    {
        _selectedId = item.Id;
    }

    private ShapeDocument? GetDocument(WorkspaceItem item)
    {
        return Store.GetDocument(item, out _);
    }

    private void Rename(WorkspaceItem item, string? name)
    {
        Store.Rename(item.Id, name ?? item.Code);
    }

    private void LoadIntoEditor(WorkspaceItem item)
    {
        Store.PendingLoad = item;

        Nav.NavigateTo(Nav.BaseUri);
    }

    private void ClearAll()
    {
        Store.Clear();

        _slotA = null;
        _slotB = null;
        _selectedId = null;

        ResetResult();
    }

    private void AssignSlot(bool second)
    {
        _error = "";

        if (_selectedId is null)
        {
            ShowToast("请先在左侧选择一个图形。");

            return;
        }

        if (second)
        {
            _slotB = _selectedId;
        }
        else
        {
            _slotA = _selectedId;
        }

        ResetResult();

        if (_operation == "stack")
        {
            RefreshHeightLimit();
        }
    }

    private void ClearSlot(bool second)
    {
        if (second)
        {
            _slotB = null;
        }
        else
        {
            _slotA = null;
        }

        ResetResult();
    }

    private WorkspaceItem? FindSlot(string? id)
    {
        return id is null
            ? null
            : Store.Items.FirstOrDefault(item => item.Id == id);
    }

    private void RefreshHeightLimit()
    {
        WorkspaceItem? bottom = FindSlot(_slotA);
        WorkspaceItem? top = FindSlot(_slotB);

        if (bottom is not null && top is not null)
        {
            _heightLimit = Math.Min(100, bottom.Layers + 1 + top.Layers);
        }
    }

    private string OperationClass(string operation)
    {
        return _operation == operation ? "mode-button selected" : "mode-button";
    }

    private string ModeClass(CollapseMode mode)
    {
        return _mode == mode ? "format-button active" : "format-button";
    }

    private void SetOperation(string operation)
    {
        _operation = operation;

        if (operation != "stack")
        {
            _slotB = null;
        }

        ResetResult();
    }

    private void SetMode(CollapseMode mode)
    {
        _mode = mode;
    }

    private void ResetResult()
    {
        _error = "";
        _result = null;
        _west = null;
        _east = null;
    }

    private void Compute()
    {
        ResetResult();

        WorkspaceItem? first = FindSlot(_slotA);

        if (first is null)
        {
            _error = "请先给图形框导入一个图形。";

            return;
        }

        ShapeDocument? firstDocument = Store.GetDocument(first, out string? firstError);

        if (firstDocument is null)
        {
            _error = firstError ?? "图形解析失败。";

            return;
        }

        switch (_operation)
        {
            case "stack":
                ComputeStack(firstDocument);
                break;

            case "cut":
                ComputeCut(firstDocument);
                break;

            case "pin":
                Apply(ShapePhysics.Pin(firstDocument, _mode));
                break;

            default:
                Apply(ShapePhysics.Collapse(firstDocument, _mode));
                break;
        }
    }

    private void ComputeStack(ShapeDocument baseDocument)
    {
        WorkspaceItem? topItem = FindSlot(_slotB);

        if (topItem is null)
        {
            _error = "堆叠需要上方图形。";

            return;
        }

        ShapeDocument? topDocument = Store.GetDocument(topItem, out string? topError);

        if (topDocument is null)
        {
            _error = topError ?? "上方图形解析失败。";

            return;
        }

        Apply(ShapePhysics.Stack(baseDocument, topDocument, _heightLimit, _mode));
    }

    private void ComputeCut(ShapeDocument document)
    {
        CutResult result = ShapePhysics.Cut(document, _mode);

        if (!result.Success)
        {
            _error = result.Error ?? "切割失败。";

            return;
        }

        _west = result.West;
        _east = result.East;
    }

    private void Apply(PhysicsResult result)
    {
        if (!result.Success)
        {
            _error = result.Error ?? "操作失败。";

            return;
        }

        _result = result.Document;
    }

    /// <summary>
    /// 把“输入 → 产物”拼成一张图导出，仅在已有产物时可用。
    /// </summary>
    private async Task ExportImage()
    {
        var sections = new List<object>();

        WorkspaceItem? first = FindSlot(_slotA);

        ShapeDocument? firstDocument = first is null
            ? null
            : Store.GetDocument(first, out _);

        if (_operation == "stack")
        {
            WorkspaceItem? second = FindSlot(_slotB);

            ShapeDocument? secondDocument = second is null
                ? null
                : Store.GetDocument(second, out _);

            if (firstDocument is not null)
            {
                sections.Add(new
                {
                    label = "下方图形",
                    states = new[] { ShapeCanvasState.Create(firstDocument) },
                    arrowBefore = false
                });
            }

            if (secondDocument is not null)
            {
                sections.Add(new
                {
                    label = "上方图形",
                    states = new[] { ShapeCanvasState.Create(secondDocument) },
                    arrowBefore = false
                });
            }

            if (_result is not null)
            {
                sections.Add(new
                {
                    label = "堆叠产物",
                    states = new[] { ShapeCanvasState.Create(_result) },
                    arrowBefore = true
                });
            }
        }
        else if (_operation == "cut")
        {
            if (firstDocument is not null)
            {
                sections.Add(new
                {
                    label = "原图形",
                    states = new[] { ShapeCanvasState.Create(firstDocument) },
                    arrowBefore = false
                });
            }

            if (_west is not null && _east is not null)
            {
                sections.Add(new
                {
                    label = "切割产物（西 / 东）",
                    states = new[]
                    {
                        ShapeCanvasState.Create(_west),
                        ShapeCanvasState.Create(_east)
                    },
                    arrowBefore = true
                });
            }
        }
        else
        {
            if (firstDocument is not null)
            {
                sections.Add(new
                {
                    label = "原图形",
                    states = new[] { ShapeCanvasState.Create(firstDocument) },
                    arrowBefore = false
                });
            }

            if (_result is not null)
            {
                sections.Add(new
                {
                    label = "产物",
                    states = new[] { ShapeCanvasState.Create(_result) },
                    arrowBefore = true
                });
            }
        }

        if (sections.Count < 2)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "shapeGrid.downloadComposition",
                sections,
                $"shape-editor-{DateTime.Now:yyyyMMdd-HHmmss}.png");
        }
        catch (Exception exception)
        {
            _error = $"导出图片失败：{exception.Message}";
        }
    }

    private void AddResult(ShapeDocument document, string operation)    {
        string code = Exporter.Export(document, omitTopEmptyLayers: true);

        WorkspaceAddResult result = Store.TryAdd(
            code,
            ShortCodeFormat.Full,
            document.LayerCount,
            document.PartCount,
            "operation",
            operation);

        ShowToast(result switch
        {
            WorkspaceAddResult.Added => "已加入工作区。",
            WorkspaceAddResult.Duplicate => "工作区里已有相同图形。",
            WorkspaceAddResult.Full => "工作区已满 200 条。",
            _ => "结果不是合法图形。"
        });
    }

    private async void ShowToast(string message)
    {
        _toast = message;

        await InvokeAsync(StateHasChanged);

        _toastSource?.Cancel();
        _toastSource = new CancellationTokenSource();

        try
        {
            await Task.Delay(2500, _toastSource.Token);

            _toast = "";

            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }
}
