    private string DisplayPathNodeTitle(
        ProductionPathGraphNode node) =>
        _path?.Path is null
            ? node.Title
            : FormatExchangeNodeTitle(node.Title, _path.Path.Direction);

    /// <summary>当前已构建的列里是否有造塔子配方；没有时不显示展开开关。</summary>
    private bool HasSubRecipes =>
