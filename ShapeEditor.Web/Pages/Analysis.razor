@page "/analysis"
@implements IDisposable

@using System.Globalization
@using ShapeEditor.Core.Analysis
@using ShapeEditor.Core.Analysis.Production
@using ShapeEditor.Core.Physics
@using ShapeEditor.Core.Models
@using ShapeEditor.Core.Services
@using ShapeEditor.Web.Services
@inject AnalysisRequest Request
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>图形分析</PageTitle>

<div class="analysis-page">

    <header class="editor-header">
        <h1>图形分析</h1>

        <div class="header-actions">
            <div class="code-format">
                <button class="@(_mode == CollapseMode.IncludeCycles ? "format-button active" : "format-button")"
                        @onclick="() => SetMode(CollapseMode.IncludeCycles)">
                    含循环支撑
                </button>
                <button class="@(_mode == CollapseMode.FloorOnly ? "format-button active" : "format-button")"
                        @onclick="() => SetMode(CollapseMode.FloorOnly)">
                    仅地面
                </button>
            </div>
            <button class="primary-button"
                    disabled="@(_document is null || _analyzing || _angleWorkBusy)"
                    @onclick="ExportImageAsync">
                导出图片
            </button>
            <button class="secondary-button"
                    @onclick="BackToEditor">
                返回编辑器
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-message" role="alert">
            @_errorMessage
        </div>
    }

    @if (_analyzing)
    {
        @* 分阶段计算期间只显示进度条，完成后隐藏并展示内容。 *@
        <section class="analysis-progress-card" role="status" aria-live="polite">
            <AnalysisProgressBar Stage="@_stage" Percent="@_percent" />
        </section>
    }
    else if (_analysis is null)
    {
        <div class="analysis-empty">
            还没有可分析的图形。请先在编辑器里点「分析」。
        </div>
    }
    else
    {
        <div class="analysis-body">

            <section class="analysis-shape">
                <div class="analysis-code">@_code</div>

                @if (_document is not null)
                {
                    <div class="analysis-preview-box">
                        <AnalysisShapePreview Document="_document" />
                    </div>
                }

                <div class="analysis-meta">
                    @_document!.LayerCount 层 × @_document.PartCount 象限
                </div>

                <section class="analysis-rules analysis-rules-left">
                    <div class="analysis-section-head">
                        <h2>角的判定规则</h2>
                        <button type="button" class="analysis-toggle"
                                @onclick="() => _showRules = !_showRules">
                            @(_showRules ? "隐藏" : "显示")
                        </button>
                    </div>

                    @if (_showRules)
                    {
                        <ol>
                            <li>顶针下方相邻格必须非空；顶针在最底层时视为合法。</li>
                            <li>晶体下方若存在顶针，该顶针要么在最底层，要么下方全部是顶针。</li>
                            <li>同列两层晶体之间若存在空层，则两者之间至少有两个非空格，且下方晶体的正上方非空。</li>
                            <li>最低的那层晶体：在最底层、或下方有普通形状、或下方全部是顶针。</li>
                        </ol>
                        <p class="analysis-note">角 = 竖式图的一列。四条规则全部满足才算合法。</p>
                    }
                </section>
            </section>

            <section class="analysis-cards">

                <div class="analysis-card">
                    <div class="analysis-section-head">
                        <h2>图形性质</h2>
                        <button type="button" class="analysis-toggle"
                                @onclick="() => _showProperties = !_showProperties">
                            @(_showProperties ? "隐藏" : "显示")
                        </button>
                    </div>

                    @if (_showProperties)
                    {
                        @if (_properties == ShapeProperty.None)
                        {
                            <p class="analysis-summary">没有识别到任何性质。</p>
                        }
                        else
                        {
                            <div class="property-chips">
                                @foreach (ShapeProperty property in PropertyList())
                                {
                                    <span class="property-chip">@ShapePropertyAnalyzer.NameOf(property)</span>
                                }
                            </div>
                        }

                        <p class="analysis-summary analysis-note">
                            可制作性暂等同角合法性，等角制作算法接入后细化。
                        </p>
                    }
                </div>

                <div class="analysis-card">
                    <div class="analysis-section-head">
                        <h2>角的合法性</h2>
                        <button type="button" class="analysis-toggle"
                                @onclick="() => _showAngles = !_showAngles">
                            @(_showAngles ? "隐藏" : "显示")
                        </button>
                    </div>

                    @if (!_showAngles)
                    {
                        <p class="analysis-summary">
                            @AngleSummary
                        </p>
                    }

                    @if (_showAngles)
                    {
                        <p class="analysis-summary">
                            @AngleSummary
                        </p>

                        <table class="angle-table">
                            <thead>
                                <tr>
                                    <th>角</th>
                                    <th>合法性</th>
                                    <th>可制作性</th>
                                    <th>备注</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (AngleResult angle in _analysis.Angles)
                                {
                                    <tr class="@(angle.IsLegal ? "ok" : "bad")">
                                        <td>角 @(angle.Part + 1)</td>
                                        <td>@(angle.IsLegal ? "合法" : "非法")</td>
                                        <td>@(angle.IsLegal ? "可制作" : "不可制作")</td>
                                        <td class="angle-note">@string.Join("；", angle.Failures)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <p class="analysis-note">
                            角的可制作性暂时等同于合法性，等角的制作算法接入后细化。
                        </p>
                    }
                </div>

                <div class="analysis-card">
                    <div class="analysis-section-head">
                        <h2>稳定性</h2>
                        <button type="button" class="analysis-toggle"
                                @onclick="() => _showStability = !_showStability">
                            @(_showStability ? "隐藏" : "显示")
                        </button>
                    </div>

                    @if (_showStability)
                    {
                        <p class="analysis-summary">
                            @(_analysis.IsStable
                                ? "稳定：按当前规则执行一次下落后，图形与原来完全一致。"
                                : "不稳定：执行一次下落后图形会发生变化。")
                        </p>
                    }
                </div>

                <div class="analysis-card">
                    <div class="analysis-section-head">
                        <h2>半边稳定性</h2>
                        <button type="button" class="analysis-toggle"
                                @onclick="() => _showHalf = !_showHalf">
                            @(_showHalf ? "隐藏" : "显示")
                        </button>
                    </div>

                    @if (!_showHalf && _half is not null)
                    {
                        <p class="analysis-summary">
                            @($"共 {_half.DirectionCount} 个交换方向，其中 {_half.LegalDirections.Count} 个合法。")
                        </p>
                    }

                    @if (_showHalf)
                    {
                        <p class="analysis-summary">
                            @(_half is null
                                ? "需要在偶数象限的图形上分析。"
                                : (_half.IsExchangeable
                                    ? $"可交换：共 {_half.DirectionCount} 个交换方向，其中 {_half.LegalDirections.Count} 个合法。"
                                    : $"不可交换：共 {_half.DirectionCount} 个交换方向，没有合法的。"))
                        </p>

                        <p class="analysis-note">
                            交换方向合法的定义：两个半边都稳定，并且该方向上左右各两个带柱子的半半边也全部稳定。
                        </p>

                        <p class="analysis-note">
                            <span class="legend-ok">绿色</span> 为合法方向，
                            <span class="legend-bad">红色</span> 为不合法方向。
                        </p>

                        <label class="half-toggle">
                            <input type="checkbox" checked="@_onlyLegalDirections"
                                   @onchange="OnOnlyLegalDirectionsChanged" />
                            只显示合法方向
                        </label>

                        @if (_half is not null && _half.Directions.Count > 0)
                        {
                            @* 一轴一块：每个轴一张卡片，块内方向自动换行，整块区域纵向滚动。 *@
                            <div class="half-axis-scroll">
                                @foreach (var group in _half.Directions.GroupBy(direction => direction.Axis))
                                {
                                    @* 开关只影响页面显示；导出始终列出全部方向。 *@
                                    List<ExchangeDirection> visibleDirections = group
                                        .Where(direction => !_onlyLegalDirections || direction.IsLegal)
                                        .ToList();

                                    <section class="half-axis-block">
                                        <div class="axis-title">轴 @(group.Key + 1)</div>

                                        @if (visibleDirections.Count == 0)
                                        {
                                            <p class="half-direction-empty">没有合法的交换方向。</p>
                                        }
                                        else
                                        {
                                            @* 方向逐个列出、各占一格；块宽时一行多个，窄时自动折行，不横向滚动。 *@
                                            <div class="half-direction-list">
                                                @foreach (ExchangeDirection direction in visibleDirections)
                                                {
                                                    <span class="half-direction @(direction.IsLegal ? "ok" : "bad")">@direction.Display</span>
                                                }
                                            </div>
                                        }
                                    </section>
                                }
                            </div>
                        }
                    }
                </div>

                @if (_half is not null)
                {
                    <div class="analysis-card">
                        <div class="analysis-section-head">
                            <h2>制作路径</h2>
                            <button type="button" class="analysis-toggle"
                                    @onclick="() => _showPath = !_showPath">
                                @(_showPath ? "隐藏" : "显示")
                            </button>
                        </div>

                        @if (_showPath)
                        {
                            @* 交换工序：沿用原来的分层节点图；没有合法交换方向时不显示。 *@
                            @if (_half.IsExchangeable)
                            {
                                <section class="analysis-subsection">
                                    <div class="analysis-section-head analysis-subsection-head">
                                        <h3>交换工序</h3>
                                        <button type="button" class="analysis-toggle"
                                                @onclick="() => _showPathExchange = !_showPathExchange">
                                            @(_showPathExchange ? "隐藏" : "显示")
                                        </button>
                                    </div>

                                    @if (_showPathExchange)
                                    {
                                        <p class="analysis-summary">
                                            @PathSummaryText
                                        </p>

                                        @* 未覆盖不是不可制作：用小字明确提示，避免被当成 bug。 *@
                                        @if (PathOutcomeNote is not null)
                                        {
                                            <p class="analysis-note">
                                                @PathOutcomeNote
                                            </p>
                                        }

                                        @if (_path is not null && _path.Path is not null)
                                        {
                                            @if (_pathGraph is not null)
                                            {
                                                <div class="path-graph-scroll"
                                                     style="height:@(PathGraphViewportHeight)px">
                                                    <div class="graph-canvas path-graph-canvas"
                                                         style="width:@Px(_pathGraph.Width)px;height:@Px(_pathGraph.Height)px">

                                                        <svg class="graph-arrows"
                                                             width="@Px(_pathGraph.Width)"
                                                             height="@Px(_pathGraph.Height)">
                                                            @foreach (ProductionPathGraphEdge edge in _pathGraph.Edges)
                                                            {
                                                                <path d="@edge.Path"
                                                                      class="path-edge@(edge.IsWaste ? " waste" : "")"
                                                                      data-edge-from="@edge.FromId"
                                                                      data-edge-to="@edge.ToId" />

                                                                <polygon points="@edge.Arrow"
                                                                         class="path-arrow@(edge.IsWaste ? " waste" : "")"
                                                                         data-edge-from="@edge.FromId"
                                                                         data-edge-to="@edge.ToId" />
                                                            }
                                                        </svg>

                                                        @foreach (ProductionPathGraphNode node in _pathGraph.Nodes)
                                                        {
                                                            <div class="graph-node path-node @(node.IsResult ? "result" : "") @(node.IsWaste ? "waste" : "") @(node.IsPending ? "pending" : "") @node.KindClass"
                                                                 data-node-id="@node.Id"
                                                                 style="left:@Px(node.X)px;top:@Px(node.Y)px;width:@Px(node.Width)px;height:@Px(node.Height)px">

                                                                @* 顶针 / 堆叠 / 块：右上角类型小标签。 *@
                                                                @if (node.HasKindTag)
                                                                {
                                                                    <span class="path-node-kind">@node.KindTag</span>
                                                                }

                                                                <div class="path-node-head" title="@node.Title">
                                                                    @node.Title
                                                                </div>

                                                                <div class="graph-node-body path-node-body">
                                                                    @if (node.Shape is not null)
                                                                    {
                                                                        <PathNodePreview Document="node.Shape" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="ws-slot-empty">待接入</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <p class="analysis-note">
                                                    节点按层从上到下排列，同层节点从左到右紧排，层间固定留 80px 画箭头；
                                                    行数由制作路径决定（顶针 / 堆叠 / 块会追加新层）。
                                                    预览保持 30px 单元格原始尺寸，图形较宽或较高时容器可横纵滚动。
                                                    废料节点淡显、虚线边框，指向废料的箭头为灰色虚线；
                                                    顶针、堆叠、块分别用青绿 / 橙 / 绿边框与「顶P」「堆」「块」小标签区分。
                                                </p>
                                            }
                                        }
                                    }
                                </section>
                            }

                            @* 角的工序：按列列出分类、算法、构造、顶针次数、子配方与步骤节点链；默认隐藏。 *@
                            <section class="analysis-subsection">
                                <div class="analysis-section-head analysis-subsection-head">
                                    <h3>角的工序</h3>
                                    <div class="analysis-head-actions">
                                        @* 子配方展开状态用页面字段记住，一处开关控制全部列。 *@
                                        @if (_showPathAngles && HasSubRecipes)
                                        {
                                            <button type="button" class="analysis-toggle"
                                                    @onclick="ToggleSubRecipes">
                                                @(_expandSubRecipes ? "收起全部子配方" : "展开全部子配方")
                                            </button>
                                        }

                                        <button type="button" class="analysis-toggle"
                                                @onclick="TogglePathAngles">
                                            @(_showPathAngles ? "隐藏" : "显示")
                                        </button>
                                    </div>
                                </div>

                                @if (_showPathAngles)
                                {
                                    @if (_angleWorkBusy)
                                    {
                                        @* 首次展开（或图形/规则变化后）按列构建；默认隐藏时不计算。 *@
                                        <div class="analysis-inline-progress">
                                            <AnalysisProgressBar Stage="@_angleWorkStage"
                                                                 Percent="@_angleWorkPercent" />
                                        </div>
                                    }
                                    else
                                    {
                                    <p class="analysis-summary">@AngleWorkSummary</p>

                                    <p class="analysis-note">
                                        碎晶角按「前态 → 切割 → 下落 → 顶针 → 支柱交接（撑）→ 目标」列出；
                                        标题显示论文分档算法与构造（无晶体 / 简单角 / 算法 1–6 / 兜底构造）。
                                        节点预览固定 30px 单元格、1:1 不缩放。
                                        工序前态按目标图形层数作为画布高度，需要更高脚手架才能成立的构造会标为尚未完全验证。
                                        造塔子配方（交换链，rank 0）可折叠展开，展开状态由标题栏的开关统一控制。
                                        单列做不出来的角会带「半边工序」标签：候选名与配对列写在标题行，
                                        卡片下方再单列一行 n/2 列一起做的步骤链（两列逐格核对），同样固定 30px 单元格预览。
                                    </p>

                                    <div class="angle-work-list">
                                        @foreach (AngleWorkColumn work in AngleWorks)
                                        {
                                            <section class="angle-work-card" data-angle-column="@work.Column">
                                                <div class="angle-work-head">
                                                    <h4>角 @(work.Column + 1)</h4>

                                                    @* 无晶体 / Simple 的算法文案已经带分类，不再重复显示「简单角」。 *@
                                                    @if (work.ShowKindChip)
                                                    {
                                                        <span class="angle-kind @(work.IsSimple ? "simple" : "break")">@work.KindText</span>
                                                    }

                                                    @* 半边工序：紫色标签 + 候选名 + 配对列，与「碎晶角 / 简单角」并列。 *@
                                                    @if (work.Half is not null)
                                                    {
                                                        <span class="angle-kind half">@work.Half.Title</span>
                                                        <span class="angle-half-candidate">@work.Half.CandidateText</span>
                                                        <span class="angle-half-columns">@work.Half.ColumnsText</span>
                                                    }

                                                    @if (!string.IsNullOrEmpty(work.AlgorithmText))
                                                    {
                                                        <span class="angle-algorithm">@work.AlgorithmText</span>
                                                    }

                                                    @if (work.ShowConstructionChip)
                                                    {
                                                        <span class="angle-construction">@work.ConstructionText</span>
                                                    }

                                                    @if (!string.IsNullOrEmpty(work.RankText))
                                                    {
                                                        <span class="angle-rank">@work.RankText</span>
                                                    }

                                                    @if (!work.IsComplete)
                                                    {
                                                        <span class="angle-status-chip">尚未完全验证</span>
                                                    }
                                                </div>

                                                @if (work.IsSimple)
                                                {
                                                    <p class="angle-work-simple">@work.SimpleText</p>
                                                }
                                                else
                                                {
                                                    @if (work.Nodes.Count > 0)
                                                    {
                                                        @* 一列一条节点链；箭头由 shapeGridLayoutEdges 按真实矩形绘制。 *@
                                                        <AngleWorkNodeChain Nodes="work.Nodes"
                                                                            Edges="work.Edges"
                                                                            Width="work.GraphWidth"
                                                                            Height="work.GraphHeight" />
                                                    }

                                                    @if (!work.IsComplete)
                                                    {
                                                        @* 未通过验证时如实展示原因和限制，不伪造后续步骤。 *@
                                                        <div class="angle-work-warning">
                                                            <p class="angle-work-status">该列工序尚未完全验证</p>

                                                            @if (!string.IsNullOrWhiteSpace(work.Note))
                                                            {
                                                                <p class="angle-work-note">@work.Note</p>
                                                            }

                                                            @if (work.Limitations.Count > 0)
                                                            {
                                                                <p class="angle-work-limitation-title">限制与前提</p>
                                                                <ul class="angle-work-limitations">
                                                                    @foreach (string limitation in work.Limitations)
                                                                    {
                                                                        <li>@limitation</li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </div>
                                                    }
                                                }

                                                @if (work.Half is not null)
                                                {
                                                    @*
                                                        半边工序：n/2 列一起做的那一刀，单独成一行。
                                                        主步骤链是目标角的单列视角，这里才是 k 列逐格核对用的步骤链；
                                                        节点样式与主链完全一致（30px 单元格 1:1 竖式图）。
                                                    *@
                                                    <section class="angle-half" data-angle-half="@work.Column">
                                                        <div class="angle-half-head">
                                                            <h5>@(work.Half.Title)节点链</h5>
                                                            <span class="angle-half-pair">配对列 @work.Half.PairColumnsText</span>
                                                        </div>

                                                        @if (work.Half.Nodes.Count > 0)
                                                        {
                                                            <AngleWorkNodeChain Nodes="work.Half.Nodes"
                                                                                Edges="work.Half.Edges"
                                                                                Width="work.Half.GraphWidth"
                                                                                Height="work.Half.GraphHeight" />
                                                        }

                                                        @if (!work.Half.IsComplete)
                                                        {
                                                            @* 半边工序没验证完时同样如实标注，并给出 Note 与限制小字。 *@
                                                            <div class="angle-work-warning angle-half-warning">
                                                                <p class="angle-work-status">@work.Half.StatusText</p>

                                                                @if (!string.IsNullOrWhiteSpace(work.Half.Note))
                                                                {
                                                                    <p class="angle-work-note">@work.Half.Note</p>
                                                                }

                                                                @if (work.Half.Limitations.Count > 0)
                                                                {
                                                                    <p class="angle-work-limitation-title">限制与前提</p>
                                                                    <ul class="angle-work-limitations">
                                                                        @foreach (string limitation in work.Half.Limitations)
                                                                        {
                                                                            <li>@limitation</li>
                                                                        }
                                                                    </ul>
                                                                }
                                                            </div>
                                                        }
                                                    </section>
                                                }

                                                @if (work.SubRecipe is not null)
                                                {
                                                    @* 造塔子配方：标题常显，内容由「展开全部子配方」开关控制。 *@
                                                    <section class="angle-subrecipe">
                                                        <div class="angle-subrecipe-head">
                                                            <h5>@work.SubRecipe.Title</h5>
                                                            <span class="angle-subrecipe-summary">@work.SubRecipe.Summary</span>
                                                            @if (!_expandSubRecipes)
                                                            {
                                                                <span class="angle-subrecipe-hint">
                                                                    （点上方「展开全部子配方」查看零件预览）
                                                                </span>
                                                            }
                                                        </div>

                                                        @if (_expandSubRecipes)
                                                        {
                                                            <div class="angle-subrecipe-items">
                                                                @foreach (AngleSubRecipeItem item in work.SubRecipe.Items)
                                                                {
                                                                    <div class="angle-subrecipe-item @(item.IsWaste ? "waste" : "")">
                                                                        <div class="angle-subrecipe-item-title">@item.Title</div>

                                                                        @if (item.Shape is not null)
                                                                        {
                                                                            <PathNodePreview Document="item.Shape" />
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </section>
                                                }
                                            </section>
                                        }
                                    </div>
                                    }
                                }
                            </section>
                        }
                    </div>
                }

            </section>
        </div>


    }
</div>

@code {
    private string _code = "";

    /// <summary>当前分析阶段文字，显示在页面顶部进度条下方。</summary>
    private string _stage = "解析短代码";

    /// <summary>当前分析进度百分比（0–100）。</summary>
    private int _percent;

    /// <summary>是否正在分阶段计算；为 true 时只显示进度条。</summary>
    private bool _analyzing;

    /// <summary>分析/导出失败的顶部提示。</summary>
    private string _errorMessage = "";

    /// <summary>页面是否已销毁；用于让后台的分阶段任务尽快退出。</summary>
    private bool _disposed;

    /// <summary>
    /// 分析运行版本号。重新分析或页面销毁时自增，
    /// 仍在运行的旧任务在下一个阶段边界发现版本不一致后直接退出。
    /// </summary>
    private int _analysisVersion;

    private ShapeDocument? _document;

    private ShapeAnalysisResult? _analysis;

    private CollapseMode _mode = CollapseMode.IncludeCycles;

    private HalfStabilityResult? _half;

    private bool _onlyLegalDirections = true;

    private void OnOnlyLegalDirectionsChanged(
        ChangeEventArgs args)
    {
        _onlyLegalDirections = args.Value is bool value && value;
    }

    private ShapeProperty _properties = ShapeProperty.None;

    private ProductionPathResult? _path;

    /// <summary>
    /// 制作路径的节点图布局，与页面和导出共用。
    /// </summary>
    private ProductionPathGraph? _pathGraph;

    /// <summary>
    /// 角工序卡片。只在「角的工序」区域显示时按列异步构建；
    /// 隐藏状态下保持 null，不做任何 AngleWorkOrderBuilder.Build。
    /// </summary>
    private IReadOnlyList<AngleWorkColumn>? _angleWorks;

    /// <summary>_angleWorks 对应的图形，用于切换图形后失效重算。</summary>
    private ShapeDocument? _angleWorksDocument;

    /// <summary>角工序是否正在按列构建；为 true 时该区域显示自己的进度条。</summary>
    private bool _angleWorkBusy;

    /// <summary>角工序构建的阶段文字。</summary>
    private string _angleWorkStage = "角的工序";

    /// <summary>角工序构建进度百分比（0–100）。</summary>
    private int _angleWorkPercent;

    /// <summary>角工序构建版本号，隐藏区域或重新分析时自增以取消旧任务。</summary>
    private int _angleWorkVersion;

    /// <summary>
    /// 已构建的角工序卡片；尚未构建或已失效时返回空列表。
    /// 这里刻意不做惰性计算，避免渲染线程被大图形的逐列 Build 阻塞。
    /// </summary>
    private IReadOnlyList<AngleWorkColumn> AngleWorks =>
        _angleWorks ?? Array.Empty<AngleWorkColumn>();

    /// <summary>当前已构建的列里是否有造塔子配方；没有时不显示展开开关。</summary>
    private bool HasSubRecipes =>
        AngleWorks.Any(work => work.SubRecipe is not null);

    /// <summary>角工序区域的汇总：简单角数量与碎晶角验证进度。</summary>
    private string AngleWorkSummary
    {
        get
        {
            IReadOnlyList<AngleWorkColumn> works = AngleWorks;

            if (works.Count == 0)
            {
                return "没有可分析的角。";
            }

            int simple = works.Count(work => work.IsSimple);
            int breaks = works.Count - simple;

            if (breaks == 0)
            {
                return $"共 {works.Count} 个角：全部是简单角，无需工序。";
            }

            int complete = works.Count(work => !work.IsSimple && work.IsComplete);

            string summary =
                $"共 {works.Count} 个角：{simple} 个简单角、{breaks} 个碎晶角；" +
                $"{complete}/{breaks} 列碎晶角工序已验证通过";

            return complete == breaks
                ? summary + "。"
                : summary + $"，{breaks - complete} 列尚未完全验证。";
        }
    }

    private readonly ShortCodeExporter Exporter = new();

    /// <summary>
    /// 制作路径的主结论，按三态显示：
    /// 可制作给方向；不可制作说明存在不合法角；未覆盖说明超出算法覆盖范围。
    /// </summary>
    private string PathSummaryText
    {
        get
        {
            if (_path is null)
            {
                return "无法解析。";
            }

            if (_path.IsProducible && _path.Path is not null)
            {
                return $"可制作：方向 {_path.Path.Direction}" +
                       $"（{(_path.Path.DirectionLegal ? "合法方向" : "不合法方向")}）。";
            }

            if (_path.Outcome == PipelineOutcome.Uncovered)
            {
                return "暂不支持解析：该图形的制作路径超出当前算法覆盖范围。";
            }

            return "不可制作：存在不合法角。";
        }
    }

    /// <summary>未覆盖时的小字说明；其余状态为 null，不渲染。</summary>
    private string? PathOutcomeNote =>
        _path?.Outcome == PipelineOutcome.Uncovered
            ? "这并不代表不可制作。"
            : null;

    private List<string> BuildPathLines()
    {
        var lines = new List<string>();

        if (_path is null)
        {
            lines.Add("无法解析。");

            return lines;
        }

        if (!_path.IsProducible || _path.Path is null)
        {
            lines.Add(PathSummaryText);

            if (PathOutcomeNote is not null)
            {
                lines.Add(PathOutcomeNote);
            }

            return lines;
        }

        lines.Add($"可制作：方向 {_path.Path.Direction}（{(_path.Path.DirectionLegal ? "合法方向" : "不合法方向")}）");

        foreach (ProductionStep step in _path.Path.Steps)
        {
            string code = step.Shape is null
                ? ""
                : " " + Exporter.Export(step.Shape, omitTopEmptyLayers: true);

            lines.Add(step.Title + code);
        }

        return lines;
    }
    private void RecomputePath()
    {
        _path = _document is null ? null : ProductionPathParser.Parse(_document, _mode);

        _pathGraph = _path?.Path is null
            ? null
            : ProductionPathGraph.Create(_path.Path);
    }

    /// <summary>
    /// 节点图容器的可视高度：节点少时按内容自适应，节点多时固定高度并滚动。
    /// </summary>
    private double PathGraphViewportHeight =>
        _pathGraph is null
            ? 240
            : Math.Min(560, Math.Max(220, Math.Ceiling(_pathGraph.Height)));

    /// <summary>把坐标格式化成不带千分位分隔符的像素值。</summary>
    private static string Px(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 交换工序与角的工序都可能有节点图；只要有一处在显示就校正箭头。
        bool showExchange =
            _showPath && _showPathExchange && _pathGraph is not null;

        bool showAngles =
            _showPath &&
            _showPathAngles &&
            _analysis is not null &&
            _half is not null &&
            // 半边工序的节点链也是图，同样要按真实矩形校正箭头。
            AngleWorks.Any(work =>
                work.Nodes.Count > 0 ||
                (work.Half?.Nodes.Count ?? 0) > 0);

        if (!showExchange && !showAngles)
        {
            return;
        }

        try
        {
            // 复用工作区的连线绘制，但按分层图规则取锚点：
            // 跨层用上排底边中点 → 下排顶边中点。
            // JS 会遍历页面上所有 .graph-canvas，因此交换工序与多列角工序可以共存。
            await JS.InvokeVoidAsync("shapeGridLayoutEdges", true);
        }
        catch
        {
            /* 连线绘制失败不影响页面其余内容 */
        }
    }

    // 分析板块的显隐开关，只影响渲染，不影响分析结果；除角的工序外默认全部显示。
    private bool _showProperties = true;

    private bool _showAngles = true;

    private bool _showStability = true;

    private bool _showHalf = true;

    private bool _showPath = true;

    // 制作路径下的两个子区域：交换工序（分层节点图）与角的工序（按列节点链）。
    // 交换工序默认显示；角的工序保持默认隐藏（用户要求），展开时才按需计算。
    private bool _showPathExchange = true;

    // 角的工序默认隐藏（用户要求）；展开时才构建工序，避免隐藏时白算。
    private bool _showPathAngles = false;

    /// <summary>
    /// 是否展开全部造塔子配方。用一个页面字段记住展开状态，重渲染不会丢；
    /// 子配方预览较宽，默认收起，避免每列都撑出一大块内容。
    /// </summary>
    private bool _expandSubRecipes;

    private bool _showRules = true;

    private readonly ShapeProperty[] _propertyOrder =
    {
        ShapeProperty.ContainsCrystal,
        ShapeProperty.ContainsPin,
        ShapeProperty.CrystalAndEmptySameLayer,
        ShapeProperty.CrystalAndPinSameLayer,
        ShapeProperty.GapBelowShape,
        ShapeProperty.GapBelowCrystal,
        ShapeProperty.MixedCrystalColorsSameLayer,
        ShapeProperty.Stable,
        ShapeProperty.CycleSupported,
        ShapeProperty.Exchangeable
    };

    private IEnumerable<ShapeProperty> PropertyList() =>
        _propertyOrder.Where(property => (_properties & property) == property);

    /// <summary>
    /// 角的统计摘要：折叠与展开时显示同一句话。
    /// </summary>
    private string AngleSummary =>
        _analysis is null
            ? ""
            : $"共 {_analysis.Angles.Count} 个角，{_analysis.LegalCount} 个合法" +
              (_analysis.IsFullyLegal ? "（全部合法）" : "");

    private async Task TogglePathAngles()
    {
        if (_showPathAngles)
        {
            _showPathAngles = false;

            // 隐藏区域立即取消仍在进行的按列构建；下次展开时重新构建。
            _angleWorkVersion++;
            _angleWorkBusy = false;

            await InvokeAsync(StateHasChanged);

            return;
        }

        _showPathAngles = true;

        // 先渲染出该区域的进度条，再进行可能耗时的逐列构建。
        await InvokeAsync(StateHasChanged);

        if (!_showPath || _document is null)
        {
            return;
        }

        if (_angleWorks is not null &&
            ReferenceEquals(_angleWorksDocument, _document))
        {
            return;
        }

        await BuildAngleWorksAsync();
    }

    /// <summary>切换全部子配方的展开状态；状态保存在页面字段里。</summary>
    private void ToggleSubRecipes()
    {
        _expandSubRecipes = !_expandSubRecipes;
    }

    private void SetMode(
        CollapseMode mode)
    {
        if (_mode == mode)
        {
            return;
        }

        _mode = mode;

        // 模式影响稳定性与制作路径，整页重新分阶段计算。
        _ = AnalyzeAsync();
    }

    /// <summary>
    /// 导出当前分析图。只把「当前显示」的板块写进 payload，
    /// 隐藏的板块不会出现在图片里。
    /// </summary>
    private async Task ExportImageAsync()
    {
        if (_document is null || _analysis is null)
        {
            return;
        }

        _errorMessage = "";

        try
        {
            await JS.InvokeVoidAsync(
                "shapeGrid.downloadAnalysis",
                BuildExportPayload(),
                $"shape-analysis-{DateTime.Now:yyyyMMdd-HHmmss}.png");
        }
        catch (Exception exception)
        {
            _errorMessage = $"导出图片失败：{exception.Message}";
        }
    }

    private AnalysisExportPayload BuildExportPayload()
    {
        ShapeDocument document = _document!;

        var payload = new AnalysisExportPayload
        {
            Title = "图形分析",
            Code = _code,
            State = ShapeCanvasState.Create(document),
            Meta = $"{document.LayerCount} 层 × {document.PartCount} 象限",
            GeneratedAt = $"生成时间：{DateTime.Now:yyyy-MM-dd HH:mm}"
        };

        if (_showProperties)
        {
            payload.Sections.Add(BuildPropertiesSection());
        }

        if (_showAngles)
        {
            payload.Sections.Add(BuildAnglesSection());
        }

        if (_showStability)
        {
            payload.Sections.Add(BuildStabilitySection());
        }

        if (_showHalf)
        {
            payload.Sections.AddRange(BuildHalfSections());
        }

        if (_showRules)
        {
            payload.Sections.Add(BuildRulesSection());
        }

        // 制作路径分成交换工序与角的工序两个子区域，各自按显示状态导出；
        // 交换工序只在存在合法交换方向时出现，与页面的门控保持一致。
        if (_showPath)
        {
            if (_showPathExchange && _half is not null && _half.IsExchangeable)
            {
                payload.Sections.Add(BuildPathSection());
            }

            if (_showPathAngles && _half is not null && _angleWorks is not null)
            {
                payload.Sections.Add(BuildPathAnglesSection());
            }
        }

        return payload;
    }

    /// <summary>
    /// 制作路径的交换工序板块。可制作时导出成与页面相同的节点图（按实际尺寸整张输出，
    /// 预览不缩放、不分片）；不可制作 / 未覆盖时退回对应文本。
    /// </summary>
    private AnalysisExportSection BuildPathSection()
    {
        var section = new AnalysisExportSection
        {
            Title = "交换工序"
        };

        if (_path is null || _path.Path is null || _pathGraph is null)
        {
            section.Lines = BuildPathLines();

            // 未覆盖的小字说明单独交给 JS 用小字号绘制。
            if (PathOutcomeNote is not null)
            {
                section.Lines.Remove(PathOutcomeNote);

                section.Notes.Add(PathOutcomeNote);
            }

            return section;
        }

        ProductionPath path = _path.Path;

        section.Lines.Add(
            $"可制作：方向 {path.Direction}（{(path.DirectionLegal ? "合法方向" : "不合法方向")}）。");

        var graph = new AnalysisExportGraph
        {
            Width = _pathGraph.Width,
            Height = _pathGraph.Height
        };

        foreach (ProductionPathGraphNode node in _pathGraph.Nodes)
        {
            graph.Nodes.Add(new AnalysisExportGraphNode
            {
                Id = node.Id,
                Title = node.Title,
                X = node.X,
                Y = node.Y,
                Width = node.Width,
                Height = node.Height,
                State = node.Shape is null
                    ? null
                    : ShapeCanvasState.Create(node.Shape),
                IsResult = node.IsResult,
                IsWaste = node.IsWaste,
                IsPending = node.IsPending,
                Kind = node.KindName,
                KindTag = node.KindTag
            });
        }

        foreach (ProductionPathGraphEdge edge in _pathGraph.Edges)
        {
            graph.Edges.Add(new AnalysisExportGraphEdge
            {
                FromId = edge.FromId,
                ToId = edge.ToId,
                IsWaste = edge.IsWaste
            });
        }

        section.Graph = graph;

        return section;
    }

    /// <summary>
    /// 角的工序板块：与页面一致，每个角一张卡片。
    ///
    /// 简单角只导出一行说明；碎晶角导出步骤节点链（每条链一个图，保持 30px 单元格 1:1）；
    /// 卡片标题带分类 / 算法 / 构造 / 顶针次数；造塔子配方只以小字列步骤名，不画预览；
    /// 未完全验证时在节点链后追加「该列工序尚未完全验证」、Note 与 Limitations。
    /// 只有该区域已展开并完成按列构建时才导出；隐藏或构建中不会触发额外计算。
    /// </summary>
    private AnalysisExportSection BuildPathAnglesSection()
    {
        var section = new AnalysisExportSection
        {
            Title = "角的工序"
        };

        IReadOnlyList<AngleWorkColumn> works = AngleWorks;

        section.Lines.Add(AngleWorkSummary);
        section.Lines.Add(
            "碎晶角按「前态 → 切割 → 下落 → 顶针 → 支柱交接 → 目标」列出；" +
            "标题包含论文分档算法与构造，节点预览为 30px 单元格的 1:1 竖式图。");
        section.Lines.Add(
            "工序前态按目标图形层数作为画布高度，需要更高脚手架才能成立的构造会标为尚未完全验证。");

        if (works.Any(work => work.SubRecipe is not null))
        {
            /*
             * 子配方导出策略（二选一里选了「小字列步骤名」）：
             * 四片并排预览会把导出图撑得很宽，所以统一只列步骤名，不画预览。
             */
            section.Lines.Add(
                "造塔子配方以文字步骤名列在卡片小字里，不导出零件预览（避免导出图过宽）。");
        }

        if (works.Any(work => work.Half is not null))
        {
            section.Lines.Add(
                "带「半边工序」标签的角要 n/2 列一起做：标题行写候选名与配对列，" +
                "卡片下方单独一行是那几列逐格核对的步骤链（同样 30px 单元格 1:1）。");
        }

        foreach (AngleWorkColumn work in works)
        {
            var column = new AnalysisExportAngleColumn
            {
                Title = $"角 {work.Column + 1}",
                KindText = work.KindText,
                ShowKindChip = work.ShowKindChip,
                AlgorithmText = work.AlgorithmText ?? "",
                // 半边工序的构造由「半边工序」标签承载，与页面标题行保持一致。
                ConstructionText = work.ShowConstructionChip
                    ? work.ConstructionText ?? ""
                    : "",
                RankText = work.RankText ?? "",
                IsSimple = work.IsSimple,
                IsComplete = work.IsComplete,
                StatusText = work.StatusText ?? "",
                SimpleText = work.IsSimple ? work.SimpleText : "",
                Note = work.Note,
                Limitations = work.Limitations.ToList(),
                SubRecipeLines = work.SubRecipe is null
                    ? new List<string>()
                    : new List<string>
                    {
                        work.SubRecipe.Title + "：" +
                        string.Join(
                            " → ",
                            work.SubRecipe.Items.Select(item => item.Title))
                    }
            };

            if (work.Nodes.Count > 0)
            {
                column.Graph = CreateExportGraph(
                    work.Nodes,
                    work.Edges,
                    work.GraphWidth,
                    work.GraphHeight);
            }

            /*
             * 半边工序：标题、候选名、配对列与步骤节点链一起导出，
             * 未验证完时再带上 Note 与限制小字，与页面卡片一一对应。
             */
            if (work.Half is not null)
            {
                column.HalfTitle = work.Half.Title;
                column.HalfCandidateText = work.Half.CandidateText;
                column.HalfColumnsText = work.Half.ColumnsText;
                column.HalfPairColumnsText = work.Half.PairColumnsText;
                column.HalfIsComplete = work.Half.IsComplete;
                column.HalfStatusText = work.Half.StatusText ?? "";
                column.HalfNote = work.Half.Note;
                column.HalfLimitations = work.Half.Limitations.ToList();

                if (work.Half.Nodes.Count > 0)
                {
                    column.HalfGraph = CreateExportGraph(
                        work.Half.Nodes,
                        work.Half.Edges,
                        work.Half.GraphWidth,
                        work.Half.GraphHeight);
                }
            }

            section.AngleColumns.Add(column);
        }

        return section;
    }

    /// <summary>
    /// 把一条步骤节点链（主链或半边链）转成导出图。
    /// 预览仍是 30px 单元格 1:1，导出图宽度由 JS 按节点链实际宽度撑开。
    /// </summary>
    private static AnalysisExportGraph CreateExportGraph(
        IReadOnlyList<AngleWorkNode> nodes,
        IReadOnlyList<AngleWorkEdge> edges,
        double width,
        double height)
    {
        var graph = new AnalysisExportGraph
        {
            Width = width,
            Height = height
        };

        foreach (AngleWorkNode node in nodes)
        {
            graph.Nodes.Add(new AnalysisExportGraphNode
            {
                Id = node.Id,
                Title = node.Title,
                X = node.X,
                Y = node.Y,
                Width = node.Width,
                Height = node.Height,
                State = node.Shape is null
                    ? null
                    : ShapeCanvasState.Create(node.Shape),
                Kind = node.KindName,
                KindTag = node.KindTag
            });
        }

        foreach (AngleWorkEdge edge in edges)
        {
            graph.Edges.Add(new AnalysisExportGraphEdge
            {
                FromId = edge.FromId,
                ToId = edge.ToId
            });
        }

        return graph;
    }

    private AnalysisExportSection BuildPropertiesSection()
    {
        var section = new AnalysisExportSection
        {
            Title = "图形性质"
        };

        if (_properties == ShapeProperty.None)
        {
            section.Lines.Add("没有识别到任何性质。");
        }
        else
        {
            section.Lines.Add(
                "性质：" +
                string.Join(
                    "、",
                    PropertyList().Select(ShapePropertyAnalyzer.NameOf)));
        }

        return section;
    }

    private AnalysisExportSection BuildAnglesSection()
    {
        ShapeAnalysisResult analysis = _analysis!;

        var section = new AnalysisExportSection
        {
            Title = "角的合法性"
        };

        // 汇总行仍作为表格上方的说明文本，表格只放每个角的结果。
        section.Lines.Add(
            $"共 {analysis.Angles.Count} 个角，{analysis.LegalCount} 个合法" +
            (analysis.IsFullyLegal ? "（全部合法）" : ""));

        // 与页面上的角分析表格保持相同的列。
        var table = new AnalysisExportTable
        {
            Headers = new List<string> { "角", "合法性", "可制作性", "备注" }
        };

        foreach (AngleResult angle in analysis.Angles)
        {
            table.Rows.Add(new List<string>
            {
                $"角 {angle.Part + 1}",
                angle.IsLegal ? "合法" : "非法",

                // 可制作性暂时等同于合法性，等角的制作算法接入后细化。
                angle.IsLegal ? "可制作" : "不可制作",
                angle.Failures.Count == 0
                    ? "—"
                    : string.Join("；", angle.Failures)
            });
        }

        section.Table = table;

        return section;
    }

    private AnalysisExportSection BuildStabilitySection()
    {
        var section = new AnalysisExportSection
        {
            Title = "稳定性"
        };

        section.Lines.Add(
            _analysis!.IsStable
                ? "稳定：按当前规则执行一次下落后，图形与原来完全一致。"
                : "不稳定：执行一次下落后图形会发生变化。");

        return section;
    }

    /// <summary>
    /// 半边稳定性导出成一个板块：汇总与定义作为说明文本，
    /// 之后每个轴一个轴块（块标题 + 块内全部交换方向），与页面的一轴一块一致。
    ///
    /// 轴块只带「方向文本 + 是否合法」，颜色由 JS 按 IsLegal 直接选，
    /// 不依赖表格行样式；导出始终列出全部方向，不受页面开关影响。
    /// </summary>
    private List<AnalysisExportSection> BuildHalfSections()
    {
        var summary = new AnalysisExportSection
        {
            Title = "半边稳定性"
        };

        summary.Lines.Add(
            "交换方向合法的定义：两个半边都稳定，并且该方向上左右各两个带柱子的半半边也全部稳定。");

        summary.Lines.Add("绿色为合法方向，红色为不合法方向。");

        if (_half is null)
        {
            summary.Lines.Insert(0, "需要在偶数象限的图形上分析。");

            return new List<AnalysisExportSection> { summary };
        }

        summary.Lines.Insert(
            0,
            _half.IsExchangeable
                ? $"可交换：共 {_half.DirectionCount} 个交换方向，其中 {_half.LegalDirections.Count} 个合法。"
                : $"不可交换：共 {_half.DirectionCount} 个交换方向，没有合法的。");

        foreach (IGrouping<int, ExchangeDirection> group in
                 _half.Directions.GroupBy(direction => direction.Axis))
        {
            var axisBlock = new AnalysisExportAxisBlock
            {
                Title = $"轴 {group.Key + 1}"
            };

            // 导出列全部方向：页面上的「只显示合法方向」开关不影响图片。
            foreach (ExchangeDirection direction in group)
            {
                axisBlock.Items.Add(new AnalysisExportAxisDirection
                {
                    Text = direction.Display,
                    IsLegal = direction.IsLegal
                });
            }

            summary.AxisBlocks.Add(axisBlock);
        }

        return new List<AnalysisExportSection> { summary };
    }

    private static AnalysisExportSection BuildRulesSection()
    {
        var section = new AnalysisExportSection
        {
            Title = "角的判定规则"
        };

        section.Lines.Add("1. 顶针下方相邻格必须非空；顶针在最底层时视为合法。");
        section.Lines.Add("2. 晶体下方若存在顶针，该顶针要么在最底层，要么下方全部是顶针。");
        section.Lines.Add("3. 同列两层晶体之间若存在空层，则两者之间至少有两个非空格，且下方晶体的正上方非空。");
        section.Lines.Add("4. 最低的那层晶体：在最底层、或下方有普通形状、或下方全部是顶针。");
        section.Lines.Add("角 = 竖式图的一列。四条规则全部满足才算合法。");

        return section;
    }

    private void BackToEditor()
    {
        Nav.NavigateTo("/");
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Request.Code))
        {
            return;
        }

        _code = Request.Code;

        /*
         * 不能在 OnParametersSet 里同步跑完所有分析，否则大图形会白屏卡住。
         * 这里启动分阶段异步任务：每个阶段之间 await 并触发重绘，
         * 让顶部的进度条能够真实推进。
         */
        _ = AnalyzeAsync();
    }

    /// <summary>
    /// 分阶段执行全部分析。
    ///
    /// Blazor WebAssembly 只有一个线程，<see cref="Task.Run(Action)"/> 并不能真正并行；
    /// 这里靠阶段之间把控制权让给浏览器（StateHasChanged + 极短延迟）来刷新进度条。
    /// </summary>
    private async Task AnalyzeAsync()
    {
        int version = ++_analysisVersion;

        _errorMessage = "";

        // 重新分析时让旧的角工序结果和仍在进行的逐列构建全部失效。
        _angleWorkVersion++;
        _angleWorkBusy = false;
        _angleWorks = null;
        _angleWorksDocument = null;

        _analysis = null;
        _half = null;
        _path = null;
        _pathGraph = null;
        _properties = ShapeProperty.None;
        _document = null;

        _analyzing = true;

        try
        {
            // ---- 解析短代码 0–15% ----
            await ReportProgressAsync(version, "解析短代码", 0);

            if (IsStale(version))
            {
                return;
            }

            if (!ShortCodeParser.TryInferDimensions(
                    _code,
                    out int layers,
                    out int parts,
                    out _))
            {
                FinishAnalysis();
                return;
            }

            await ReportProgressAsync(version, "解析短代码", 8);

            if (IsStale(version))
            {
                return;
            }

            ParseResult parsed = new ShortCodeParser().Parse(
                _code,
                layers,
                parts);

            if (!parsed.Success || parsed.Document is null)
            {
                FinishAnalysis();
                return;
            }

            ShapeDocument document = parsed.Document;
            _document = document;

            // 解析阶段收尾到 15%，随后进入角合法性。
            await ReportProgressAsync(version, "解析短代码", 15);

            // ---- 角合法性 15–40%：逐列计算，百分比随列数推进 ----
            await ReportProgressAsync(version, "角合法性", 15);

            var angles = new List<AngleResult>(document.PartCount);

            for (int part = 0; part < document.PartCount; part++)
            {
                if (IsStale(version))
                {
                    return;
                }

                angles.Add(ShapeAngleAnalyzer.AnalyzeAngle(document, part));

                int percent = 15 +
                    (int)(25.0 * (part + 1) / document.PartCount);

                if (percent != _percent)
                {
                    await ReportProgressAsync(version, "角合法性", percent);
                }
            }

            // ---- 稳定性 40–55% ----
            await ReportProgressAsync(version, "稳定性", 40);

            if (IsStale(version))
            {
                return;
            }

            bool isStable = ShapeAngleAnalyzer.IsStable(document, _mode);

            // 逐列算好的角结果与单独的稳定性判定合并成页面使用的分析结果。
            _analysis = new ShapeAnalysisResult(
                document.PartCount,
                document.LayerCount,
                angles)
            {
                IsStable = isStable,
                Mode = _mode
            };

            await ReportProgressAsync(version, "稳定性", 55);

            if (IsStale(version))
            {
                return;
            }

            // ---- 半边稳定性 55–85% ----
            await ReportProgressAsync(version, "半边稳定性", 55);

            _half = HalfStabilityAnalyzer.Analyze(document, _mode);

            await ReportProgressAsync(version, "半边稳定性", 85);

            if (IsStale(version))
            {
                return;
            }

            // ---- 图形性质 85–90% ----
            await ReportProgressAsync(version, "图形性质", 85);

            _properties = ShapePropertyAnalyzer.Analyze(
                document,
                isStable,
                _half?.IsExchangeable ?? false,
                _mode);

            await ReportProgressAsync(version, "图形性质", 90);

            if (IsStale(version))
            {
                return;
            }

            // ---- 制作路径 90–100%，含 ProductionPathParser ----
            await ReportProgressAsync(version, "制作路径", 90);

            RecomputePath();

            await ReportProgressAsync(version, "制作路径", 100);

            if (IsStale(version))
            {
                return;
            }

            _analyzing = false;

            await InvokeAsync(StateHasChanged);

            // 角工序默认隐藏；若之前展开着，则按列异步重建，并单独显示它自己的进度。
            if (_showPath && _showPathAngles && !_disposed)
            {
                _ = BuildAngleWorksAsync();
            }
        }
        catch (Exception exception)
        {
            if (IsStale(version))
            {
                return;
            }

            _errorMessage = $"分析失败：{exception.Message}";
            FinishAnalysis();
        }
    }

    /// <summary>解析失败或分析抛异常时收起进度条，回到空状态。</summary>
    private void FinishAnalysis()
    {
        _analyzing = false;
        _document = null;
        _analysis = null;
        _half = null;
        _path = null;
        _pathGraph = null;
        _properties = ShapeProperty.None;
        _angleWorks = null;
        _angleWorksDocument = null;

        if (!_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>当前异步任务是否已被更新的分析或页面销毁取代。</summary>
    private bool IsStale(
        int version) =>
        _disposed || version != _analysisVersion;

    /// <summary>
    /// 更新阶段与百分比并让浏览器重绘。
    ///
    /// StateHasChanged 只更新渲染队列，必须再让出到浏览器事件循环，
    /// 进度条才会真正画出来；单次 1ms，按整数百分比推进，次数有限。
    /// </summary>
    private async Task ReportProgressAsync(
        int version,
        string stage,
        int percent)
    {
        if (IsStale(version))
        {
            return;
        }

        _stage = stage;
        _percent = Math.Clamp(percent, 0, 100);

        await InvokeAsync(StateHasChanged);
        await Task.Delay(1);
    }

    /// <summary>
    /// 按列构建「角的工序」。只有该区域展开时才调用；
    /// 每列完成后更新一次自己的进度条，隐藏区域或重新分析时立即退出。
    /// </summary>
    private async Task BuildAngleWorksAsync()
    {
        ShapeDocument? document = _document;

        if (document is null || _disposed)
        {
            return;
        }

        int version = ++_angleWorkVersion;

        _angleWorkBusy = true;
        _angleWorkStage = "角的工序";
        _angleWorkPercent = 0;
        _angleWorks = null;
        _angleWorksDocument = null;

        await InvokeAsync(StateHasChanged);
        await Task.Delay(1);

        try
        {
            var works = new List<AngleWorkColumn>(document.PartCount);

            for (int column = 0; column < document.PartCount; column++)
            {
                if (_disposed || version != _angleWorkVersion)
                {
                    return;
                }

                works.Add(AngleWorkColumnBuilder.BuildColumn(
                    document,
                    column,
                    document.LayerCount));

                int percent = (int)(100.0 * (column + 1) /
                    document.PartCount);

                if (percent != _angleWorkPercent)
                {
                    await ReportAngleProgressAsync(version, percent);
                }
            }

            if (_disposed || version != _angleWorkVersion)
            {
                return;
            }

            _angleWorks = works;
            _angleWorksDocument = document;
            _angleWorkPercent = 100;
            _angleWorkBusy = false;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            if (_disposed || version != _angleWorkVersion)
            {
                return;
            }

            _errorMessage = $"角工序计算失败：{exception.Message}";
            _angleWorkBusy = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>更新角工序自己的进度条并让出一次浏览器事件循环。</summary>
    private async Task ReportAngleProgressAsync(
        int version,
        int percent)
    {
        if (_disposed || version != _angleWorkVersion)
        {
            return;
        }

        _angleWorkPercent = Math.Clamp(percent, 0, 100);

        await InvokeAsync(StateHasChanged);
        await Task.Delay(1);
    }

    public void Dispose()
    {
        _disposed = true;

        // 让仍在运行的分阶段任务在下一个检查点退出。
        _analysisVersion++;
        _angleWorkVersion++;
    }
}
