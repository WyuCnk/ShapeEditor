    /// <summary>是否有三层工序卡片；有则替换旧的「制作路径」区块。</summary>
    private bool HasWorkOrderCards => _cards is { HasCards: true };

    /// <summary>工序卡片区块的汇总：总张数、分层张数与验证进度。</summary>
    private string CardsSummary
    {
        get
        {
            if (_cards is null || !_cards.HasCards)
            {
                return "没有工序卡片。";
            }

            string layers = string.Join(
                "、",
                _cards.Layers.Select(layer => $"{layer.Title} {layer.Cards.Count} 张"));

            return $"共 {_cards.TotalCount} 张卡（{layers}）；" +
                   $"已验证 {_cards.VerifiedCount}/{_cards.TotalCount}。";
        }
    }

    /// <summary>层容器的样式类：交换 / 半边 / 角各用一种强调色。</summary>
    private static string LayerClass(
        WorkOrderCardLayerKind kind) =>
        kind switch
        {
            WorkOrderCardLayerKind.Exchange => "work-order-layer-exchange",
            WorkOrderCardLayerKind.Half => "work-order-layer-half",
            WorkOrderCardLayerKind.Corner => "work-order-layer-corner",
            _ => "work-order-layer-corner"
        };

    /// <summary>
    /// 页面与导出实际展示的角卡片。
    ///
    /// 半边工序是「n/2 列一起做」的合并卡片：
    /// <list type="bullet">
    /// <item>同一个 <c>Target.Columns</c> 只保留第一张，避免重复画同一张合并卡片；</item>
    /// <item>已经被某张半边卡片覆盖的角不再单独显示（用户要求：需要半边工序时，
    /// 就不再显示单独制作某个角）；未被覆盖的角照常显示普通卡片。</item>
    /// </list>
    /// 正常的 Core 输出只会在主列上带 Half，这里只是防御性去重。
    /// </summary>
    private IReadOnlyList<AngleWorkColumn> VisibleAngleWorks
    {
        get
        {
            IReadOnlyList<AngleWorkColumn> works = AngleWorks;

            if (!works.Any(work => work.Half is not null))
            {
                return works;
            }

            var halfColumnSets = works
                .Where(work => work.Half is not null)
                .Select(work => new HashSet<int>(work.Half!.TargetColumns))
                .ToList();

            var seen = new HashSet<string>(StringComparer.Ordinal);
            var visible = new List<AngleWorkColumn>(works.Count);

            foreach (AngleWorkColumn work in works)
            {
                if (work.Half is not null)
                {
                    string key = string.Join(
                        "-",
                        work.Half.TargetColumns);

                    if (seen.Add(key))
                    {
                        visible.Add(work);
                    }

                    continue;
                }

                // 这一列已被某张半边卡片覆盖 ⇒ 不再单独显示。
                if (halfColumnSets.Any(columns => columns.Contains(work.Column)))
                {
                    continue;
                }

                visible.Add(work);
            }

            return visible;
        }
    }

    /// <summary>
    /// 当前图形里确实走了半边工序的 <c>Half.Target.Columns</c>（0 起）。
    ///
    /// 优先复用已构建的角工序（展开过「角的工序」时零额外计算）；
    /// 没展开时只为 n = 4 的 4 列各调一次 <see cref="AngleWorkOrderBuilder.Build"/>，
    /// 用来判定交换文案该写「半边」还是普通列号。n ≠ 4 没有半边工序，直接空。
    /// </summary>
    private IReadOnlyList<IReadOnlyList<int>> HalfTargetColumns
    {
        get
        {
            ShapeDocument? document = _document;

            if (document is null || document.PartCount != 4)
            {
                return Array.Empty<IReadOnlyList<int>>();
            }

            if (_halfTargetColumns is not null &&
                ReferenceEquals(_halfTargetColumnsDocument, document))
            {
                return _halfTargetColumns;
            }

            var targets = new List<IReadOnlyList<int>>();

            if (_angleWorks is not null)
            {
                foreach (AngleWorkColumn work in _angleWorks)
                {
                    if (work.Half is not null)
                    {
                        targets.Add(work.Half.TargetColumns);
                    }
                }
            }
            else
            {
                int cap = document.LayerCount;

                for (int column = 0;
                     column < document.PartCount;
                     column++)
                {
                    AngleWorkOrder order = AngleWorkOrderBuilder.Build(
                        document,
                        column,
                        cap);

                    if (order.Half is not null)
                    {
                        targets.Add(order.Half.Target.Columns?.ToArray() ??
                                    Array.Empty<int>());
                    }
                }
            }

            _halfTargetColumns = targets;
            _halfTargetColumnsDocument = document;

            return targets;
        }
    }

    /// <summary>
