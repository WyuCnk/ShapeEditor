    private string FormatExchangeDirection(
        string direction) =>
        ExchangeDisplay.FormatDirection(
            direction,
            _document?.PartCount ?? 0,
            HalfTargetColumns);

    /// <summary>交换节点「交换得到左/右半边」的显示标题（半边称呼与方向文本一致）。</summary>
    private string FormatExchangeNodeTitle(
        string title,
        string direction) =>
        ExchangeDisplay.FormatSideNodeTitle(
            title,
            direction,
            _document?.PartCount ?? 0,
            HalfTargetColumns);

    /// <summary>
