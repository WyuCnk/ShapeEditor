<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShapeEditor.Maui.WorkspacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="工作区">

    <Grid Padding="10" RowSpacing="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标签行 -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="TabBar" Spacing="6" />
        </ScrollView>

        <!-- 节点操作行：作用于当前选中的节点，未选中时全部禁用 -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6">
                <Button x:Name="CollapseButton"
                        Text="下落"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnCollapseNode" />

                <Button x:Name="PinButton"
                        Text="顶针"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnPinNode" />

                <Button x:Name="CutButton"
                        Text="切割"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnCutNode" />

                <Button x:Name="StackButton"
                        Text="堆叠"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnStackNode" />

                <Button x:Name="ExchangeButton"
                        Text="交换"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnExchangeNode" />

                <Button x:Name="CopyButton"
                        Text="复制"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnCopyNode" />

                <Button x:Name="PasteButton"
                        Text="粘贴"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnPasteNode" />

                <Button x:Name="DeleteButton"
                        Text="删除"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnDeleteNode" />

                <Button x:Name="AutoLayoutButton"
                        Text="自动布局"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnAutoLayout" />

                <!-- 选中素材或节点后可用：交给编辑器 / 打开分析页 -->
                <Button x:Name="AddToEditorButton"
                        Text="加到编辑区"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnAddToEditor" />

                <Button x:Name="AnalyzeButton"
                        Text="分析"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnAnalyzeSelected" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 工具行 -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
        <HorizontalStackLayout Spacing="6">
            <Button x:Name="CycleModeButton"
                    Text="含循环支撑"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnToggleMode" />

            <Label Text="高度上限"
                   FontSize="12"
                   VerticalTextAlignment="Center" />

            <Entry x:Name="MaxLayersEntry"
                   WidthRequest="56"
                   FontSize="12"
                   Keyboard="Numeric"
                   Completed="OnMaxLayersChanged" />

            <Button Text="导出图片"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnExportImage" />

            <Button Text="清空"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnClear" />
        </HorizontalStackLayout>
        </ScrollView>

        <Label x:Name="StatusLabel"
               Grid.Row="3"
               FontSize="11"
               TextColor="#6B6B76" />

        <!-- 图例：字母表示类型，颜色表示部件颜色 -->
        <HorizontalStackLayout Grid.Row="4" Spacing="10" Margin="0,0,0,6">

            <Label Text="图例"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="S 形状"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="c 晶体"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="P 顶针"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="- 空位　色块 = 部件颜色（灰 = 无颜色）"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />
        </HorizontalStackLayout>

        <!-- 主体：素材 + 画布 -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="108" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollView Grid.Column="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="MaterialList" Spacing="6" Padding="0,0,6,0" />
            </ScrollView>

            <!--
                画布视口：裁剪 + 滚动 + 落点。

                画布放在 ScrollView 里，平移与滚动边界全部交给平台的 ScrollView，
                画布侧不再写 Translation，整个页面只有一套坐标。
                缩放只改 Canvas.Scale（锚点 0,0）和 ScaledHost 的请求尺寸，
                滚动范围自然等于「逻辑画布 × 比例」。

                素材落点挂在视口上（铺满，与虚线边框一致）：
                落点坐标加上滚动量、除以比例，就回到逻辑画布坐标，
                不会出现「看着在边框里、拖过去却没反应」。
            -->
            <Grid Grid.Column="1"
                  x:Name="CanvasViewport"
                  IsClippedToBounds="True"
                  BackgroundColor="White">

                <Grid.GestureRecognizers>
                    <!-- 素材拖到画布视口任意位置都能落点 -->
                    <DropGestureRecognizer AllowDrop="True" Drop="OnCanvasDrop" />
                </Grid.GestureRecognizers>

                <ScrollView x:Name="CanvasScroll"
                            Orientation="Both"
                            HorizontalScrollBarVisibility="Never"
                            VerticalScrollBarVisibility="Never">
                    <!--
                        滚动宿主：请求尺寸 = 逻辑画布尺寸 × 比例。
                        画布本身仍按 1 倍尺寸布局，视觉大小由 Scale 决定，
                        所以在滚动宿主里贴左上角（锚点 0,0）即可。
                    -->
                    <Grid x:Name="ScaledHost"
                          SizeChanged="OnScaledHostSizeChanged">

                        <Grid.GestureRecognizers>
                            <!--
                                画布缩得比视口小时，四周的空白落在滚动宿主上；
                                宿主也挂一份捏合手势，与画布共用同一个处理函数，
                                保证虚线边框圈出来的范围里都能捏合缩放。
                            -->
                            <PinchGestureRecognizer PinchUpdated="OnCanvasPinchUpdated" />
                        </Grid.GestureRecognizers>

                        <AbsoluteLayout x:Name="Canvas"
                                        AnchorX="0"
                                        AnchorY="0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        BackgroundColor="White">
                            <AbsoluteLayout.GestureRecognizers>
                                <!-- 点空白处取消堆叠 / 交换的第二输入选择 -->
                                <TapGestureRecognizer Tapped="OnCanvasTapped" />

                                <!-- 双指捏合缩放：只改显示比例，节点坐标与导出都不变 -->
                                <PinchGestureRecognizer PinchUpdated="OnCanvasPinchUpdated" />
                            </AbsoluteLayout.GestureRecognizers>
                        </AbsoluteLayout>
                    </Grid>
                </ScrollView>
            </Grid>

            <!--
                画布边框：钉在视口外圈，用来一眼看出「哪里能拖、哪里能放」。

                它和视口占同一个 Grid 单元，不参与画布的缩放与滚动，
                所以 0.4–2.0 任意比例、任意滚动位置下边框都严格贴住视口边缘，
                与素材落点范围完全一致。
                InputTransparent 保证它不吃手势；只占 1px，不遮挡节点。
            -->
            <Border Grid.Column="1"
                    InputTransparent="True"
                    Stroke="#C9BFF0"
                    StrokeThickness="1"
                    StrokeDashArray="4,3"
                    StrokeShape="RoundRectangle 2"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

            <!-- 缩放控件：浮在画布右下角，不参与画布的平移与缩放 -->
            <Border Grid.Column="1"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,8,8"
                    Padding="4"
                    Stroke="#E6E2F2"
                    StrokeThickness="1"
                    BackgroundColor="#F5FFFFFF"
                    StrokeShape="RoundRectangle 10">
                <HorizontalStackLayout Spacing="4">
                    <Button x:Name="ZoomOutButton"
                            Text="−"
                            FontSize="14"
                            WidthRequest="32"
                            HeightRequest="30"
                            Padding="0"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            CornerRadius="8"
                            BackgroundColor="#EFEAF9"
                            TextColor="#512BD4"
                            Clicked="OnZoomOut" />

                    <Label x:Name="ZoomLabel"
                           Text="100%"
                           FontSize="11"
                           WidthRequest="44"
                           TextColor="#6B6B76"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button x:Name="ZoomInButton"
                            Text="+"
                            FontSize="14"
                            WidthRequest="32"
                            HeightRequest="30"
                            Padding="0"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            CornerRadius="8"
                            BackgroundColor="#EFEAF9"
                            TextColor="#512BD4"
                            Clicked="OnZoomIn" />

                    <Button x:Name="ZoomResetButton"
                            Text="重置"
                            FontSize="11"
                            WidthRequest="44"
                            HeightRequest="30"
                            Padding="0"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            CornerRadius="8"
                            BackgroundColor="#EFEAF9"
                            TextColor="#512BD4"
                            Clicked="OnZoomReset" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
