<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShapeEditor.Maui.WorkspacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="工作区">

    <Grid Padding="10" RowSpacing="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标签行 -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="TabBar" Spacing="6" />
        </ScrollView>

        <!-- 节点操作行：作用于当前选中的节点，未选中时全部禁用 -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6">
                <Button x:Name="CollapseButton"
                        Text="下落"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnCollapseNode" />

                <Button x:Name="PinButton"
                        Text="顶针"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnPinNode" />

                <Button x:Name="CutButton"
                        Text="切割"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnCutNode" />

                <Button x:Name="StackButton"
                        Text="堆叠"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnStackNode" />

                <Button x:Name="ExchangeButton"
                        Text="交换"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnExchangeNode" />

                <Button x:Name="CopyButton"
                        Text="复制"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnCopyNode" />

                <Button x:Name="PasteButton"
                        Text="粘贴"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnPasteNode" />

                <Button x:Name="DeleteButton"
                        Text="删除"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnDeleteNode" />

                <Button x:Name="AutoLayoutButton"
                        Text="自动布局"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnAutoLayout" />

                <!-- 选中素材或节点后可用：交给编辑器 / 打开分析页 -->
                <Button x:Name="AddToEditorButton"
                        Text="加到编辑区"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnAddToEditor" />

                <Button x:Name="AnalyzeButton"
                        Text="分析"
                        FontSize="12"
                        HeightRequest="32"
                        CornerRadius="8"
                        IsEnabled="False"
                        Clicked="OnAnalyzeSelected" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 工具行 -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
        <HorizontalStackLayout Spacing="6">
            <Button x:Name="CycleModeButton"
                    Text="含循环支撑"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnToggleMode" />

            <Label Text="高度上限"
                   FontSize="12"
                   VerticalTextAlignment="Center" />

            <Entry x:Name="MaxLayersEntry"
                   WidthRequest="56"
                   FontSize="12"
                   Keyboard="Numeric"
                   Completed="OnMaxLayersChanged" />

            <Button Text="导出图片"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnExportImage" />

            <Button Text="清空"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnClear" />
        </HorizontalStackLayout>
        </ScrollView>

        <Label x:Name="StatusLabel"
               Grid.Row="3"
               FontSize="11"
               TextColor="#6B6B76" />

        <!-- 图例：字母表示类型，颜色表示部件颜色 -->
        <HorizontalStackLayout Grid.Row="4" Spacing="10" Margin="0,0,0,6">

            <Label Text="图例"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="S 形状"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="c 晶体"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="P 顶针"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="- 空位　色块 = 部件颜色（灰 = 无颜色）"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />
        </HorizontalStackLayout>

        <!-- 主体：素材 + 画布 -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="108" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollView Grid.Column="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="MaterialList" Spacing="6" Padding="0,0,6,0" />
            </ScrollView>

            <!--
                画布视口：只负责裁剪，不参与滚动。

                这里不能用 ScrollView：Android 的 NestedScrollView 在竖向拖动超过
                触摸阈值时会无条件拦截触摸（即使内容根本不需要滚动），
                子视图的 Pan / Pinch 会收到 Canceled，表现就是节点拖一下就不跟手、
                捏合缩放时灵时不灵、拖动中突然跳位。
                普通容器 + IsClippedToBounds 只裁剪、不抢手势。
            -->
            <Grid Grid.Column="1"
                  x:Name="CanvasViewport"
                  IsClippedToBounds="True"
                  SizeChanged="OnCanvasViewportSizeChanged">

                <!--
                    宿主尺寸 = 视口尺寸；画布贴左上角摆放（平移量为 0 时看到左上角），缩放锚点 0.5。

                    素材落点挂在宿主上，而不是画布上：画布缩小后只占视口中间一小块，
                    剩下的白底（宿主背景）看着和画布一样，落点如果只认画布，
                    拖到边上就会静默失败。宿主铺满整个视口，落点再按缩放 / 平移
                    换算回画布坐标，和「画布边框」圈出来的范围完全一致。
                -->
                <Grid x:Name="CanvasHost"
                      BackgroundColor="White">

                    <Grid.GestureRecognizers>
                        <!-- 素材拖到画布视口时，在落点创建节点 -->
                        <DropGestureRecognizer AllowDrop="True" Drop="OnCanvasDrop" />
                    </Grid.GestureRecognizers>

                    <AbsoluteLayout x:Name="Canvas"
                                    AnchorX="0.5"
                                    AnchorY="0.5"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    BackgroundColor="White">
                        <AbsoluteLayout.GestureRecognizers>
                            <!-- 点空白处取消堆叠 / 交换的第二输入选择 -->
                            <TapGestureRecognizer Tapped="OnCanvasTapped" />

                            <!-- 双指捏合缩放：只改显示比例，节点坐标与导出都不变 -->
                            <PinchGestureRecognizer PinchUpdated="OnCanvasPinchUpdated" />

                            <!-- 单指在空白处拖动平移画布；落在节点卡片上时由卡片的拖动处理 -->
                            <PanGestureRecognizer PanUpdated="OnCanvasPanUpdated" />
                        </AbsoluteLayout.GestureRecognizers>
                    </AbsoluteLayout>
                </Grid>
            </Grid>

            <!--
                画布边框：钉在视口外圈，用来一眼看出「哪里是画布」。

                它和视口占同一个 Grid 单元，但不参与画布的 Scale / Translation，
                所以 0.4–2.0 任意缩放、任意平移时边框都严格贴住视口边缘。
                InputTransparent 保证它不吃手势；只占 1px，不遮挡节点。
            -->
            <Border Grid.Column="1"
                    InputTransparent="True"
                    Stroke="#C9BFF0"
                    StrokeThickness="1"
                    StrokeDashArray="4,3"
                    StrokeShape="RoundRectangle 2"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

            <!-- 缩放控件：浮在画布右下角，不参与画布的平移与缩放 -->
            <Border Grid.Column="1"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,8,8"
                    Padding="4"
                    Stroke="#E6E2F2"
                    StrokeThickness="1"
                    BackgroundColor="#F5FFFFFF"
                    StrokeShape="RoundRectangle 10">
                <HorizontalStackLayout Spacing="4">
                    <Button x:Name="ZoomOutButton"
                            Text="−"
                            FontSize="14"
                            WidthRequest="32"
                            HeightRequest="30"
                            Padding="0"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            CornerRadius="8"
                            BackgroundColor="#EFEAF9"
                            TextColor="#512BD4"
                            Clicked="OnZoomOut" />

                    <Label x:Name="ZoomLabel"
                           Text="100%"
                           FontSize="11"
                           WidthRequest="44"
                           TextColor="#6B6B76"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                    <Button x:Name="ZoomInButton"
                            Text="+"
                            FontSize="14"
                            WidthRequest="32"
                            HeightRequest="30"
                            Padding="0"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            CornerRadius="8"
                            BackgroundColor="#EFEAF9"
                            TextColor="#512BD4"
                            Clicked="OnZoomIn" />

                    <Button x:Name="ZoomResetButton"
                            Text="重置"
                            FontSize="11"
                            WidthRequest="44"
                            HeightRequest="30"
                            Padding="0"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            CornerRadius="8"
                            BackgroundColor="#EFEAF9"
                            TextColor="#512BD4"
                            Clicked="OnZoomReset" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
