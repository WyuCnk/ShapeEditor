<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShapeEditor.Maui.WorkspacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="工作区">

    <Grid Padding="10" RowSpacing="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标签行 -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="TabBar" Spacing="6" />
        </ScrollView>

        <!-- 工具行 -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
        <HorizontalStackLayout Spacing="6">
            <Button x:Name="CycleModeButton"
                    Text="含循环支撑"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnToggleMode" />

            <Label Text="高度上限"
                   FontSize="12"
                   VerticalTextAlignment="Center" />

            <Entry x:Name="MaxLayersEntry"
                   WidthRequest="56"
                   FontSize="12"
                   Keyboard="Numeric"
                   Completed="OnMaxLayersChanged" />

            <Button Text="新建节点"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnCreateNode" />

            <Button Text="导出图片"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnExportImage" />

            <Button Text="清空"
                    FontSize="12"
                    HeightRequest="32"
                    CornerRadius="8"
                    Clicked="OnClear" />
        </HorizontalStackLayout>
        </ScrollView>

        <Label x:Name="StatusLabel"
               Grid.Row="2"
               FontSize="11"
               TextColor="#6B6B76" />

        <!-- 图例：字母表示类型，颜色表示部件颜色 -->
        <HorizontalStackLayout Grid.Row="3" Spacing="10" Margin="0,0,0,6">

            <Label Text="图例"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="S 形状"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="C 晶体"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="P 顶针"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />

            <Label Text="色块 = 部件颜色（灰 = 无颜色）"
                   FontSize="11"
                   TextColor="#6B6B76"
                   VerticalTextAlignment="Center" />
        </HorizontalStackLayout>

        <!-- 主体：素材 + 画布 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="108" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollView Grid.Column="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="MaterialList" Spacing="6" Padding="0,0,6,0" />
            </ScrollView>

            <ScrollView Grid.Column="1"
                        Orientation="Both"
                        HorizontalScrollBarVisibility="Always">
                <AbsoluteLayout x:Name="Canvas"
                                BackgroundColor="White" />
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
