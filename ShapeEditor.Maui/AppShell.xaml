<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShapeEditor.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ShapeEditor.Maui"
    Title="ShapeEditor.Maui">

    <TabBar>

        <ShellContent
            Title="编辑器"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="批量查看"
            ContentTemplate="{DataTemplate local:BatchPage}"
            Route="BatchPage" />

        <ShellContent
            Title="工作区"
            ContentTemplate="{DataTemplate local:WorkspacePage}"
            Route="WorkspacePage" />

    </TabBar>

</Shell>
