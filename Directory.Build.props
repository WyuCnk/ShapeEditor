<Project>

	<!--
	  三端版本策略：

	  ProductVersion 是唯一的产品版本号（发版只改这一处），
	  Android 的 versionCode、WPF 的程序集版本、Web 页脚显示都从它派生。

	  Android 的 versionCode 必须只增不减，这里按 semver 换算：
	    major * 10000 + minor * 100 + patch
	  例如 1.2.1 -> 10201；1.3.0 -> 10300。
	  注意版本号必须是三段（major.minor.patch）。
	-->
	<PropertyGroup>
		<ProductVersion>1.2.1</ProductVersion>

		<Version>$(ProductVersion)</Version>

		<!-- 不在 InformationalVersion 后面追加 commit 哈希，保持显示干净 -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<_ProductVersionMajor>$([System.Version]::Parse($(ProductVersion)).Major)</_ProductVersionMajor>
		<_ProductVersionMinor>$([System.Version]::Parse($(ProductVersion)).Minor)</_ProductVersionMinor>
		<_ProductVersionPatch>$([System.Version]::Parse($(ProductVersion)).Build)</_ProductVersionPatch>

		<AndroidVersionCode>$([MSBuild]::Add(
			$([MSBuild]::Multiply($(_ProductVersionMajor), 10000)),
			$([MSBuild]::Add(
				$([MSBuild]::Multiply($(_ProductVersionMinor), 100)),
				$(_ProductVersionPatch)))))</AndroidVersionCode>
	</PropertyGroup>

</Project>
