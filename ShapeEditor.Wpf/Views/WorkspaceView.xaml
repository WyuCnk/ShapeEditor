<UserControl x:Class="ShapeEditor.Wpf.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ShapeEditor.Wpf.Views"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#EFEAF9"
                                BorderBrush="#D8D4E8"
                                BorderThickness="1,1,1,0"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3DBF7" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D8D4E8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#212121" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 根 Grid 可获取键盘焦点，快捷键统一由 OnWorkspaceKeyDown 处理 -->
    <Grid x:Name="WorkspaceRoot"
          Margin="16"
          Focusable="True"
          KeyboardNavigation.IsTabStop="False"
          PreviewKeyDown="OnWorkspaceKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标签行 -->
        <DockPanel Grid.Row="0" Grid.Column="1" LastChildFill="False">
            <ItemsControl DockPanel.Dock="Left"
                          ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TabButton}"
                                Content="{Binding Name}"
                                Click="OnTabClick"
                                MouseDoubleClick="OnTabDoubleClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button DockPanel.Dock="Left"
                    Style="{StaticResource MiniButton}"
                    Content="+"
                    ToolTip="新建工作区"
                    Margin="2,0,8,4"
                    Click="OnNewProject" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MiniButton}"
                    Content="导入工作区"
                    Margin="4,0,0,4"
                    Command="{Binding ImportProjectCommand}" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MiniButton}"
                    Content="导出工作区"
                    Command="{Binding ExportProjectCommand}" />
        </DockPanel>

        <!-- 操作工具条：节点卡片上的按钮全部集中到这里 -->
        <WrapPanel Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,8,0,0">
            <Button Style="{StaticResource MiniButton}"
                    Content="下落"
                    ToolTip="对选中节点执行下落"
                    Command="{Binding CollapseCommand}"
                    CommandParameter="{Binding SelectedNode}"
                    IsEnabled="{Binding HasSelectedNode}" />

            <Button Style="{StaticResource MiniButton}"
                    Content="顶针"
                    ToolTip="对选中节点执行顶针"
                    Command="{Binding PinCommand}"
                    CommandParameter="{Binding SelectedNode}"
                    IsEnabled="{Binding HasSelectedNode}" />

            <Button Style="{StaticResource MiniButton}"
                    Content="切割"
                    ToolTip="把选中节点切成左右两个结果"
                    Command="{Binding CutCommand}"
                    CommandParameter="{Binding SelectedNode}"
                    IsEnabled="{Binding HasSelectedNode}" />

            <Button Style="{StaticResource MiniButton}"
                    Content="堆叠"
                    ToolTip="先选中第一个输入，点“堆叠”，再点第二个输入；Esc 取消"
                    Command="{Binding StackCommand}"
                    IsEnabled="{Binding HasSelectedNode}" />

            <Button Style="{StaticResource MiniButton}"
                    Content="复制"
                    ToolTip="复制选中节点的短代码"
                    Command="{Binding CopyCommand}"
                    IsEnabled="{Binding HasSelectedNode}" />

            <Button Style="{StaticResource MiniButton}"
                    Content="粘贴"
                    ToolTip="在 (80,80) 新建节点并写入复制的短代码"
                    Command="{Binding PasteCommand}"
                    IsEnabled="{Binding HasSelectedNode}" />

            <Button Style="{StaticResource MiniButton}"
                    Content="删除"
                    ToolTip="删除选中节点及其下游"
                    Command="{Binding DeleteNodeCommand}"
                    CommandParameter="{Binding SelectedNode}"
                    IsEnabled="{Binding HasSelectedNode}" />
        </WrapPanel>

        <!-- 工具行 -->
        <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,6">
            <RadioButton Content="含循环支撑"
                         GroupName="mode"
                         Height="26"
                         FontSize="12"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Margin="0,0,4,0"
                         IsChecked="{Binding IsCycleMode, Mode=OneWay}"
                         Click="OnModeCycle" />

            <RadioButton Content="仅地面"
                         GroupName="mode"
                         Height="26"
                         FontSize="12"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0"
                         IsChecked="{Binding IsFloorMode, Mode=OneWay}"
                         Click="OnModeFloor" />

            <TextBlock Text="高度上限"
                       VerticalAlignment="Center"
                       Foreground="#6B6B76"
                       FontSize="12" />

            <TextBox Width="60"
                     Margin="6,0,12,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding MaxLayers, UpdateSourceTrigger=LostFocus}" />

            <Button Style="{StaticResource MiniButton}"
                    Content="新建节点"
                    Command="{Binding NewNodeCommand}"
                    Margin="0,0,4,0" />

            <Button Style="{StaticResource MiniButton}"
                    Content="导出图片"
                    Command="{Binding ExportImageCommand}"
                    Margin="0,0,4,0" />

            <Button Style="{StaticResource MiniButton}"
                    Content="清空画布"
                    Command="{Binding ClearNodesCommand}" />
        </WrapPanel>

        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Margin="2,0,0,8"
                   FontSize="12"
                   Foreground="#6B6B76"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap">
            <Run Text="{Binding HintText, Mode=OneWay}" />
            <Run Text="{Binding StoragePath, Mode=OneWay}" />
        </TextBlock>

        <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                Style="{StaticResource Card.Panel}"
                Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="素材"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#6B6B76"
                           Margin="0,0,0,8" />

                <ListBox ItemsSource="{Binding Materials}"
                         SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <EventSetter Event="PreviewMouseLeftButtonDown"
                                         Handler="OnMaterialMouseLeftButtonDown" />
                            <EventSetter Event="PreviewMouseMove"
                                         Handler="OnMaterialMouseMove" />
                            <EventSetter Event="MouseDoubleClick"
                                         Handler="OnMaterialDoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="200" Margin="0,0,0,10">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#EEEAF7"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="120">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           Margin="4" />
                                </Border>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="2,4,0,0" />

                                <TextBlock Text="{Binding DimensionText}"
                                           FontSize="11"
                                           Foreground="#6B6B76"
                                           Margin="2,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="4"
              Grid.Column="1"
              MouseLeftButtonDown="OnCanvasMouseLeftButtonDown">

            <Border Style="{StaticResource Card.Panel}"
                    Padding="0"
                    ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Top">
                    <Grid x:Name="CanvasSurface"
                          Width="{Binding CanvasWidth}"
                          Height="{Binding CanvasHeight}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Background="#FFFFFF"
                          AllowDrop="True"
                          DragOver="OnCanvasDragOver"
                          Drop="OnCanvasDrop">

                        <!-- 连线画在节点之下 -->
                        <ItemsControl ItemsSource="{Binding Edges}"
                                      IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="0" />
                                    <Setter Property="Canvas.Top" Value="0" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Path Data="{Binding LineGeometry}"
                                          Stroke="#512BD4"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 节点卡片：只保留标题、删除、竖式预览和摘要 -->
                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding NodeWidth}"
                                            Height="{Binding NodeHeight}"
                                            CornerRadius="12"
                                            SnapsToDevicePixels="True"
                                            MouseLeftButtonDown="OnNodeClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#D0D0D0" />
                                                <Setter Property="BorderThickness" Value="1" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResult}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#512BD4" />
                                                        <Setter Property="Background" Value="#FAF8FF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#512BD4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="48" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="8,2,6,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="24" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Header}"
                                                               FontSize="12"
                                                               Foreground="#6B6B76"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <Button Grid.Column="1"
                                                            Content="×"
                                                            Width="18"
                                                            Height="18"
                                                            FontSize="12"
                                                            Padding="0"
                                                            BorderThickness="0"
                                                            Background="Transparent"
                                                            Foreground="#A00000"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            ToolTip="删除该节点及其下游"
                                                            Click="OnDeleteNode" />
                                                </Grid>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding SummaryText}"
                                                           FontSize="10"
                                                           Foreground="#8B8B96"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Background="#FFFFFF"
                                                    CornerRadius="0,0,11,11">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Width="{Binding PreviewWidth}"
                                                           Height="{Binding PreviewHeight}"
                                                           Stretch="None"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"
                                                           Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />

                                                    <TextBlock Text="{Binding PlaceholderText}"
                                                               FontSize="12"
                                                               Foreground="#B0B0BA"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVis}}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 箭头单独一层，画在节点之上且不参与命中测试 -->
                        <ItemsControl ItemsSource="{Binding Edges}"
                                      IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="0" />
                                    <Setter Property="Canvas.Top" Value="0" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Path Data="{Binding ArrowGeometry}"
                                          Fill="#512BD4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
