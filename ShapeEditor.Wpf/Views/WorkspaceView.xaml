<UserControl x:Class="ShapeEditor.Wpf.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ShapeEditor.Wpf.Views"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#EFEAF9"
                                BorderBrush="#D8D4E8"
                                BorderThickness="1,1,1,0"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3DBF7" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D8D4E8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#212121" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标签行 -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <ItemsControl DockPanel.Dock="Left"
                          ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TabButton}"
                                Content="{Binding Name}"
                                Click="OnTabClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button DockPanel.Dock="Left"
                    Style="{StaticResource MiniButton}"
                    Content="+"
                    ToolTip="新建工作区"
                    Margin="2,0,8,4"
                    Click="OnNewProject" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MiniButton}"
                    Content="导入工作区"
                    Margin="4,0,0,4"
                    Command="{Binding ImportProjectCommand}" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource MiniButton}"
                    Content="导出工作区"
                    Command="{Binding ExportProjectCommand}" />
        </DockPanel>

        <!-- 工具行 -->
        <WrapPanel Grid.Row="1" Margin="0,8,0,6">
            <RadioButton Content="含循环支撑"
                         GroupName="mode"
                         Height="26"
                         FontSize="12"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Margin="0,0,4,0"
                         IsChecked="{Binding IsCycleMode, Mode=OneWay}"
                         Click="OnModeCycle" />

            <RadioButton Content="仅地面"
                         GroupName="mode"
                         Height="26"
                         FontSize="12"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0"
                         IsChecked="{Binding IsFloorMode, Mode=OneWay}"
                         Click="OnModeFloor" />

            <TextBlock Text="高度上限"
                       VerticalAlignment="Center"
                       Foreground="#6B6B76"
                       FontSize="12" />

            <TextBox Width="60"
                     Margin="6,0,12,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding MaxLayers, UpdateSourceTrigger=LostFocus}" />

            <Button Style="{StaticResource MiniButton}"
                    Content="新建节点"
                    Command="{Binding NewNodeCommand}"
                    Margin="0,0,4,0" />

            <Button Style="{StaticResource MiniButton}"
                    Content="导出图片"
                    IsEnabled="False"
                    ToolTip="路径图导出即将支持"
                    Margin="0,0,4,0" />

            <Button Style="{StaticResource MiniButton}"
                    Content="清空画布"
                    Command="{Binding ClearNodesCommand}" />
        </WrapPanel>

        <TextBlock Grid.Row="2"
                   Margin="2,0,0,8"
                   FontSize="12"
                   Foreground="#6B6B76"
                   Text="提示：双击标签重命名；点击连线上的操作文字可以调整标签位置。" />

        <!-- 主体 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card.Panel}"
                    Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="素材"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#6B6B76"
                               Margin="0,0,0,8" />

                    <ListBox ItemsSource="{Binding Materials}"
                             SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="200" Margin="0,0,0,10">
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#EEEAF7"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Height="120">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               Margin="4" />
                                    </Border>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,4,0,0" />

                                    <TextBlock Text="{Binding DimensionText}"
                                               FontSize="11"
                                               Foreground="#6B6B76"
                                               Margin="2,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource Card.Panel}"
                    Padding="0"
                    ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Width="{Binding CanvasWidth}"
                          Height="{Binding CanvasHeight}"
                          Background="#FFFFFF">

                        <ItemsControl ItemsSource="{Binding Edges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="0" />
                                    <Setter Property="Canvas.Top" Value="0" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas>
                                        <Path Data="{Binding Geometry}"
                                              Stroke="#512BD4"
                                              StrokeThickness="2"
                                              Fill="#512BD4" />

                                        <TextBlock Text="{Binding Label}"
                                                   Canvas.Left="{Binding LabelLeft}"
                                                   Canvas.Top="{Binding LabelTop}"
                                                   Background="#FFFFFF"
                                                   Padding="4,1"
                                                   FontSize="12"
                                                   Foreground="#4527A0"
                                                   Cursor="Hand"
                                                   MouseLeftButtonDown="OnEdgeLabelClick" />
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="210"
                                            CornerRadius="12"
                                            Padding="8"
                                            MouseLeftButtonDown="OnNodeClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#D0D0D0" />
                                                <Setter Property="BorderThickness" Value="1" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResult}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#512BD4" />
                                                        <Setter Property="Background" Value="#FAF8FF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#512BD4" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Header}"
                                                           FontSize="12"
                                                           Foreground="#6B6B76"
                                                           VerticalAlignment="Center" />

                                                <Button DockPanel.Dock="Right"
                                                        Content="×"
                                                        Width="20"
                                                        Height="20"
                                                        FontSize="12"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Foreground="#A00000"
                                                        HorizontalAlignment="Right"
                                                        Click="OnDeleteNode" />
                                            </DockPanel>

                                            <Border Height="130" Margin="0,6,0,6"
                                                    Background="#FFFFFF">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       Margin="4" />
                                            </Border>

                                            <TextBlock Text="{Binding RefText}"
                                                       FontSize="12"
                                                       Foreground="#8B7BBF"
                                                       Margin="0,0,0,4"
                                                       Visibility="{Binding IsRef, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsRef, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{StaticResource MiniButton}"
                                                        Content="导入素材"
                                                        Click="OnImportMaterial" />

                                                <Button Style="{StaticResource MiniButton}"
                                                        Content="引用所选"
                                                        Click="OnReferenceSelected" />
                                            </StackPanel>

                                            <Button Content="计算"
                                                    Margin="0,6,0,0"
                                                    Padding="6"
                                                    FontSize="13"
                                                    Background="#512BD4"
                                                    Foreground="#FFFFFF"
                                                    BorderThickness="0"
                                                    Visibility="{Binding IsRef, Converter={StaticResource BoolToVis}}"
                                                    Click="OnComputeStack" />

                                            <Button Content="导入所选"
                                                    Margin="0,6,0,0"
                                                    Padding="6,3"
                                                    FontSize="12"
                                                    Click="OnImportMaterial"
                                                    IsEnabled="{Binding DataContext.HasSelectedMaterial, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding IsRef, Converter={StaticResource InverseBoolToVis}}" />

                                            <WrapPanel Visibility="{Binding IsRef, Converter={StaticResource InverseBoolToVis}}">
                                                <Button Style="{StaticResource MiniButton}" Content="下落" Click="OnCollapse" />
                                                <Button Style="{StaticResource MiniButton}" Content="顶针" Click="OnPin" />
                                                <Button Style="{StaticResource MiniButton}" Content="切割" Click="OnCut" />
                                                <Button Style="{StaticResource MiniButton}" Content="在下方堆叠" Click="OnStackBelow" />
                                                <Button Style="{StaticResource MiniButton}" Content="在上方堆叠" Click="OnStackAbove" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
