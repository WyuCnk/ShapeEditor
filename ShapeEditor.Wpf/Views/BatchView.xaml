<UserControl x:Class="ShapeEditor.Wpf.Views.BatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ShapeEditor.Wpf.Controls"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="批量查看竖式图"
                   Style="{StaticResource Text.PageTitle}"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：输入区 -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card.Panel}"
                    Margin="0,0,12,0">
                <DockPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="导入 txt"
                                    Command="{Binding ImportTextCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="从文本文件导入，一行一条"
                                    Margin="0,0,8,0" />

                            <Button Content="清空"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource Button.Secondary}" />
                        </StackPanel>

                        <TextBlock Text="{Binding BatchHint}"
                                   Style="{StaticResource Text.Hint}"
                                   Margin="0,8,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton Content="短代码"
                                         IsChecked="{Binding IsFullFormat, Mode=TwoWay}"
                                         Style="{StaticResource Toggle.Mode}"
                                         Margin="0,0,4,0" />

                            <RadioButton Content="超短代码"
                                         IsChecked="{Binding IsSuperFormat, Mode=TwoWay}"
                                         Style="{StaticResource Toggle.Mode}"
                                         Grid.Column="1"
                                         Margin="4,0,0,0" />
                        </Grid>

                        <Button Content="解析并查看"
                                Command="{Binding ParseCommand}"
                                Style="{StaticResource Button.Primary}"
                                Margin="0,10,0,0" />

                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource Text.Hint}"
                                   Margin="0,8,0,0" />

                        <Border Background="{StaticResource Brush.DangerSoft}"
                                BorderBrush="{StaticResource Brush.Danger}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource Brush.Danger}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <TextBox Text="{Binding RawText}"
                             Style="{StaticResource Input.Multiline}"
                             AcceptsReturn="True"
                             IsReadOnly="False"
                             Margin="0,10,0,0"
                             ToolTip="{Binding InputPlaceholder}" />

                </DockPanel>
            </Border>

            <!-- 右：查看区 -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card.Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 头部 -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding IndexText}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,0" />

                            <TextBlock Text="{Binding CurrentItem.DimensionText}"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="上一条"
                                    Command="{Binding PreviousCommand}"
                                    IsEnabled="{Binding CanPrevious}"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,8,0"
                                    ToolTip="上一条（←）" />

                            <Button Content="下一条"
                                    Command="{Binding NextCommand}"
                                    IsEnabled="{Binding CanNext}"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="下一条（→）" />
                        </StackPanel>
                    </Grid>

                    <!-- 单条预览 -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0,10,0,10"
                            ClipToBounds="True">
                        <Grid>
                            <controls:ShapeGridView Document="{Binding CurrentItem.Document}"
                                                    IsInteractive="False"
                                                    SelectedLayer="{x:Null}"
                                                    SelectedPart="{x:Null}" />

                            <TextBlock Text="解析失败"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="{StaticResource Brush.Danger}"
                                       Visibility="{Binding CurrentItem.HasError, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="{Binding CurrentItem.Code}"
                               FontFamily="Consolas, Microsoft YaHei UI"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="2,0,2,10" />

                    <!-- 缩略图分页 -->
                    <DockPanel Grid.Row="3">
                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">
                            <Button Content="上一页"
                                    Command="{Binding PreviousPageCommand}"
                                    IsEnabled="{Binding CanPreviousPage}"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,10,0" />

                            <TextBlock Text="{Binding PageText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <Button Content="下一页"
                                    Command="{Binding NextPageCommand}"
                                    IsEnabled="{Binding CanNextPage}"
                                    Style="{StaticResource Button.Secondary}" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding PageItems}"
                                 SelectedIndex="{Binding SelectedPageOffset, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MaxHeight="230">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="3" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource Brush.Selection}" />
                                                        <Setter TargetName="Bd"
                                                                Property="BorderThickness"
                                                                Value="2" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{StaticResource Brush.Hover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="128">
                                        <TextBlock Text="{Binding DisplayIndex}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                   Margin="2,0,0,2" />

                                        <Grid Height="84">
                                            <controls:ShapeGridView Document="{Binding Document}"
                                                                    IsInteractive="False"
                                                                    Width="124"
                                                                    Height="84" />

                                            <TextBlock Text="解析失败"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{StaticResource Brush.Danger}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
