<Window x:Class="ShapeEditor.Wpf.Views.ShortcutHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键与操作说明"
        Width="620"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.PageBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ResizeMode="CanResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="快捷键与操作说明"
                   Style="{StaticResource Text.PageTitle}"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                Style="{StaticResource Card.Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">

                    <TextBlock Text="编辑"
                               Style="{StaticResource Text.SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + Z" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="撤销上一步" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + Y" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="重做" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Delete" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="把选中的单元格清空" Margin="0,3" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Esc" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="取消当前画笔与选中" Margin="0,3" />
                    </Grid>

                    <TextBlock Text="短代码"
                               Style="{StaticResource Text.SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + Enter" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="解析输入框里的短代码" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + C" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="复制短代码（焦点在输入框时按系统行为）" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + V" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="粘贴短代码（焦点在输入框时按系统行为）" Margin="0,3" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + 0" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="适应屏幕（恢复默认缩放与位置）" Margin="0,3" />
                    </Grid>

                    <TextBlock Text="文件"
                               Style="{StaticResource Text.SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + S" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="导出存档（JSON）" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + O" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="导入存档（JSON）" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + Shift + S" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="导出图片（PNG）" Margin="0,3" />
                    </Grid>

                    <TextBlock Text="视图与鼠标"
                               Style="{StaticResource Text.SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="滚轮" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="以鼠标位置为中心缩放（0.35× – 5×）" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="中键拖动" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="平移画布" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="空格 + 左键拖动" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="临时平移画布（适合只有两键的鼠标）" Margin="0,3" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="左键点击 / 拖动" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="未选画笔时选中单元格；选了画笔时绘制并支持连续拖动" Margin="0,3" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="↑ ↓ ← →" FontFamily="Consolas" Margin="0,3" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="移动模式下整体上移 / 下移 / 循环左移 / 循环右移" Margin="0,3" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Content="关闭"
                HorizontalAlignment="Right"
                Width="110"
                Margin="0,12,0,0"
                IsCancel="True"
                Style="{StaticResource Button.Primary}" />
    </Grid>
</Window>
