<Window x:Class="ShapeEditor.Wpf.Views.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShapeEditor.Wpf.Controls"
        xmlns:local="clr-namespace:ShapeEditor.Wpf.Views"
        Title="图形分析"
        Width="1000"
        Height="700"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.PageBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ResizeMode="CanResize"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="TableCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionPanel" TargetType="Border">
            <Setter Property="BorderBrush" Value="#EEEAF7" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="PropertyChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!-- 板块显隐开关：与 Web 分析页右上角的「隐藏 / 显示」按钮一致 -->
        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="#EFEAF9"
                                CornerRadius="6"
                                Padding="10,3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#E4DCF7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="隐藏" />
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Content" Value="显示" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 制作路径子区域标题（交换工序 / 角的工序） -->
        <Style x:Key="SubSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#3A3A44" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 制作路径节点卡片：图钉标题 + 1:1 竖式图预览 -->
        <DataTemplate x:Key="PathGraphNodeTemplate">
            <Grid Width="{Binding Width}"
                  Height="{Binding Height}">
                <!-- Border 不支持虚线，用 Rectangle 画卡片底与边框 -->
                <Rectangle RadiusX="12"
                           RadiusY="12">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="#FFFFFF" />
                            <Setter Property="Stroke" Value="#D0D0D0" />
                            <Setter Property="StrokeThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResult}" Value="True">
                                    <Setter Property="Fill" Value="#FAF8FF" />
                                    <Setter Property="Stroke" Value="#512BD4" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWaste}" Value="True">
                                    <Setter Property="Fill" Value="#FBFBFC" />
                                    <Setter Property="Stroke" Value="#C4C4CC" />
                                    <Setter Property="StrokeThickness" Value="1.2" />
                                    <Setter Property="StrokeDashArray" Value="4 3" />
                                </DataTrigger>
                                <!-- 顶针 / 堆叠 / 块：不同边框色，一眼区分 -->
                                <DataTrigger Binding="{Binding IsPin}" Value="True">
                                    <Setter Property="Fill" Value="#F2FBFB" />
                                    <Setter Property="Stroke" Value="#0E7C86" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStack}" Value="True">
                                    <Setter Property="Fill" Value="#FFF8EE" />
                                    <Setter Property="Stroke" Value="#B26A00" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBlock}" Value="True">
                                    <Setter Property="Fill" Value="#F3FBF4" />
                                    <Setter Property="Stroke" Value="#2E7D32" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <Grid Margin="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题行：左侧标题，右侧类型小标签（顶P / 堆 / 块） -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   LineHeight="13"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap"
                                   ClipToBounds="True">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4A3F72" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWaste}" Value="True">
                                            <Setter Property="Foreground" Value="#9A9AA5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Grid.Column="1"
                                CornerRadius="5"
                                Padding="4,1"
                                Margin="3,0,0,0"
                                VerticalAlignment="Top"
                                Visibility="{Binding HasKindTag, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#0E7C86" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStack}" Value="True">
                                            <Setter Property="Background" Value="#B26A00" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlock}" Value="True">
                                            <Setter Property="Background" Value="#2E7D32" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding KindTag}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2"
                          ClipToBounds="True">
                        <Image Source="{Binding Preview}"
                               Width="{Binding PreviewWidth}"
                               Height="{Binding PreviewHeight}"
                               Stretch="Fill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <!-- 废料预览降低对比度，与 Web 的 0.55 一致 -->
                                        <DataTrigger Binding="{Binding IsWaste}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <TextBlock Text="{Binding PlaceholderText}"
                                   FontSize="12"
                                   Foreground="#B0B0BA"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
        <!--
            工序卡片：输入 / 前态 / 可见步骤 / 输出都按 30px 单元格 1:1 绘制，
            尺寸来自 Presentation 的 CardMetrics，与旧制作路径节点保持一致。
        -->
        <DataTemplate x:Key="WorkOrderInputTemplate">
            <Border Background="#FAF8FF"
                    BorderBrush="#E6E2F2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#6B6B76"
                               Margin="0,0,0,6" />

                    <Image Source="{Binding Preview.Preview}"
                           Width="{Binding Preview.Width}"
                           Height="{Binding Preview.Height}"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 可见步骤：操作名 + 该步输出图形；「→」画在节点之后，换行时不会出现在行首。 -->
        <DataTemplate x:Key="WorkOrderStepTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="{Binding Width}"
                        Height="{Binding Height}"
                        Background="{Binding FillBrush}"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="7"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding Operation}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#4A3F72"
                                   TextTrimming="CharacterEllipsis" />

                        <Image Grid.Row="1"
                               Source="{Binding Preview.Preview}"
                               Width="{Binding Preview.Width}"
                               Height="{Binding Preview.Height}"
                               Stretch="Fill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />
                    </Grid>
                </Border>

                <TextBlock Text="→"
                           Width="22"
                           TextAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#512BD4"
                           VerticalAlignment="Center"
                           Visibility="{Binding ShowArrow, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!--
            一张工序卡：标题行单独一行（标题 + 种类 + 半边 Mode + 验证标记），
            下面是未验证警示 / legacy 说明，然后卡内区块按「输入 → 前态 → 可见步骤
            → 输出 → 角卡小字」横向流式排列；空间不足时由 CardFlowPanel 自动换行。
            未验证的卡不显示输入链（Presentation 已清空 Inputs，这里再按 HasInputs 兜一层）。
        -->
        <DataTemplate x:Key="WorkOrderCardTemplate">
            <Border VerticalAlignment="Top"
                    CornerRadius="10"
                    Padding="12"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="BorderBrush" Value="#E6E2F2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Verified}" Value="False">
                                <Setter Property="Background" Value="#FFFAFA" />
                                <Setter Property="BorderBrush" Value="#E7B6B6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- 标题行：单独一行，不再和图形区块混排 -->
                    <WrapPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#3A3A44"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,2" />

                        <Border Background="#EFEAF9"
                                CornerRadius="10"
                                Padding="7,1"
                                Margin="0,0,6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding KindText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#512BD4" />
                        </Border>

                        <Border Background="#EEF1FC"
                                CornerRadius="10"
                                Padding="7,1"
                                Margin="0,0,6,2"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasModeText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ModeText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#3F51B5" />
                        </Border>

                        <Border CornerRadius="10"
                                Padding="7,1"
                                Margin="0,0,6,2"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EAF7EE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Verified}" Value="False">
                                            <Setter Property="Background" Value="#FDEAEA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding VerifiedText}"
                                       FontSize="11"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Verified}" Value="False">
                                                <Setter Property="Foreground" Value="#C62828" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </WrapPanel>

                    <!-- 旧版 B 类·碎晶半边卡：只兼容历史数据，正常渲染并加降级说明 -->
                    <Border Background="#FFFAEB"
                            BorderBrush="#C9A227"
                            BorderThickness="3,0,0,0"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,6,0,0"
                            Visibility="{Binding HasLegacyNote, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding LegacyNote}"
                                   FontSize="12"
                                   Foreground="#7A6415"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- 未验证：红色警示 + Note；不画输入链 -->
                    <Border Background="#FDF6F6"
                            BorderBrush="#D64545"
                            BorderThickness="3,0,0,0"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,6,0,0"
                            Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="未通过真实回放"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#C62828" />

                            <TextBlock Text="{Binding Note}"
                                       FontSize="12"
                                       LineHeight="18"
                                       Foreground="#5B5B66"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!--
                        卡内区块横向流式排列：
                        输入组 → 前态 → 可见步骤 → 输出 → 角卡小字。
                        每个区块保留自己的小标题与边框；空间不足时 CardFlowPanel 自动换行，
                        区块过宽时还会在自己的内部折行（例如步骤组），不会被卡片裁切。
                    -->
                    <controls:CardFlowPanel ItemGap="12"
                                            LineGap="8"
                                            Margin="0,8,0,0">
                        <!-- 输入：上一层卡产物，多张并排 -->
                        <StackPanel Visibility="{Binding HasInputs, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="输入（上一层卡产物）"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4527A0"
                                       Margin="0,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Inputs}"
                                          ItemTemplate="{StaticResource WorkOrderInputTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 前态：输入之后、可见步骤之前；虚线紫框，不是输入链 -->
                        <StackPanel Visibility="{Binding HasPreState, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PreStateSectionTitle}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#5E35B1"
                                       Margin="0,0,0,6" />

                            <Grid HorizontalAlignment="Left">
                                <Rectangle RadiusX="8"
                                           RadiusY="8"
                                           Fill="#F6F4FF"
                                           Stroke="#B39DDD"
                                           StrokeThickness="1"
                                           StrokeDashArray="4 3" />

                                <Image Margin="9"
                                       Source="{Binding PreState.Preview}"
                                       Width="{Binding PreState.Width}"
                                       Height="{Binding PreState.Height}"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True" />
                            </Grid>
                        </StackPanel>

                        <!-- 可见步骤：操作名 + 该步输出图形 -->
                        <StackPanel Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding StepsTitle}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#4527A0"
                                       Margin="0,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Steps}"
                                          ItemTemplate="{StaticResource WorkOrderStepTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 已验证但没有可见步骤时的说明，占「步骤」的位置 -->
                        <TextBlock Text="没有可见步骤：旋转 / 废料 / 纯支撑交接等结构步骤已在 Core 中标记为隐藏。"
                                   FontSize="12"
                                   Foreground="#6B6B76"
                                   TextWrapping="Wrap"
                                   MaxWidth="340"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding ShowEmptySteps, Converter={StaticResource BoolToVis}}" />

                        <!-- 输出：2px 主色醒目边框 -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,6">
                                <TextBlock Text="输出"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#4527A0" />

                                <TextBlock Text="{Binding OutputCaption}"
                                           FontSize="11"
                                           Foreground="#6B6B76"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasOutputCaption, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Border Background="#FAF8FF"
                                    BorderBrush="#512BD4"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Padding="8"
                                    HorizontalAlignment="Left">
                                <Image Source="{Binding Output.Preview}"
                                       Width="{Binding Output.Width}"
                                       Height="{Binding Output.Height}"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True" />
                            </Border>
                        </StackPanel>

                        <!-- 角卡小字：Q1 目标角 / Q2 右柱 / Q4 左柱 -->
                        <TextBlock Text="{Binding CornerCaption}"
                                   FontSize="11"
                                   Foreground="#6B6B76"
                                   TextWrapping="Wrap"
                                   MaxWidth="220"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding HasCornerCaption, Converter={StaticResource BoolToVis}}" />
                    </controls:CardFlowPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 一层工序卡片：左侧强调色条 + 层标题（带张数）+ 纵向卡片列表（一行一张） -->
        <DataTemplate x:Key="WorkOrderCardLayerTemplate">
            <Border Background="#FBFAFF"
                    BorderBrush="#E6E2F2"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,0,12">
                <Grid>
                    <Rectangle Width="3"
                               Fill="{Binding AccentBrush}"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,10"
                               RadiusX="1.5"
                               RadiusY="1.5" />

                    <StackPanel Margin="12,10,12,12">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#3A3A44"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="{Binding CountText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#6B6B76"
                                       Margin="8,0,0,1"
                                       VerticalAlignment="Bottom" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Cards}"
                                      ItemTemplate="{StaticResource WorkOrderCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 单卡变宽后一层每行只放一张；卡内区块由 CardFlowPanel 横向排列 -->
                                    <controls:WorkOrderCardPanel ItemGap="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题、当前短代码、下落类型切换 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Margin="0,0,16,0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="图形分析"
                           Style="{StaticResource Text.PageTitle}"
                           VerticalAlignment="Center" />

                <Border Grid.Column="1"
                        Background="{StaticResource Brush.PrimarySoft}"
                        CornerRadius="8"
                        Padding="10,5"
                        Margin="14,3,0,0"
                        MaxWidth="320"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Code}"
                               FontFamily="Consolas, Microsoft YaHei UI"
                               FontSize="12"
                               Foreground="{StaticResource Brush.PrimaryDark}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Code}" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="下落规则"
                           FontSize="12"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <RadioButton Content="含循环支撑"
                             GroupName="analysisMode"
                             Style="{StaticResource Toggle.Mode}"
                             Padding="14,6"
                             Margin="0,0,6,0"
                             IsChecked="{Binding IsCycleMode, Mode=TwoWay}" />

                <RadioButton Content="仅地面"
                             GroupName="analysisMode"
                             Style="{StaticResource Toggle.Mode}"
                             Padding="14,6"
                             Margin="0,0,12,0"
                             IsChecked="{Binding IsFloorMode, Mode=TwoWay}" />

                <Button Content="导出图片"
                        Style="{StaticResource Button.Primary}"
                        Padding="14,7"
                        Margin="0,0,10,0"
                        IsEnabled="{Binding HasDocument}"
                        Click="OnExportImageClick"
                        ToolTip="把当前分析结果导出为单栏 PNG" />

                <Button Content="关闭"
                        Style="{StaticResource Button.Secondary}"
                        Padding="14,7"
                        IsCancel="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource Card.Panel}"
                Padding="0"
                ClipToBounds="True">
            <ScrollViewer x:Name="AnalysisScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：竖式图与角的判定规则 -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,16,0">
                        <TextBlock Text="竖式图"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Margin="0,0,0,6" />

                        <!--
                            竖式图 1:1 基准为 30px 单元格，等比缩小到左栏宽度，
                            高度上限 320；StretchDirection=DownOnly 保证小图不放大。
                        -->
                        <Border Background="#FFFFFF"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                MinHeight="120">
                            <Grid>
                                <Viewbox Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         MaxHeight="320"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Image Source="{Binding PreviewImage}"
                                           Width="{Binding PreviewNaturalWidth}"
                                           Height="{Binding PreviewNaturalHeight}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Viewbox>

                                <TextBlock Text="没有可显示的图形"
                                           FontSize="12"
                                           Foreground="#B0B0BA"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding DimensionText}"
                                   Style="{StaticResource Text.Hint}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />

                        <Border Background="#FAF8FF"
                                BorderBrush="#EEEAF7"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="角的判定规则"
                                           Style="{StaticResource Text.SectionTitle}"
                                           Margin="0,0,0,6" />

                                <TextBlock Style="{StaticResource Text.Hint}"
                                           Margin="0,0,0,4"
                                           Text="一、顶针下方相邻格必须非空；顶针在最底层时视为合法。" />

                                <TextBlock Style="{StaticResource Text.Hint}"
                                           Margin="0,0,0,4"
                                           Text="二、晶体下方若存在顶针，该顶针要么在最底层，要么下方全部是顶针。" />

                                <TextBlock Style="{StaticResource Text.Hint}"
                                           Margin="0,0,0,4"
                                           Text="三、同列两层晶体之间若存在空层，则两者之间至少有两个非空格，且下方晶体的正上方非空。" />

                                <TextBlock Style="{StaticResource Text.Hint}"
                                           Margin="0,0,0,4"
                                           Text="四、最低的那层晶体：在最底层、或下方有普通形状、或下方全部是顶针。" />

                                <TextBlock Style="{StaticResource Text.Hint}"
                                           Margin="0,4,0,0"
                                           Text="角 = 竖式图的一列。四条规则全部满足才算合法。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 右：分板块展示分析结果 -->
                    <StackPanel Grid.Column="1">
                        <Border Background="{StaticResource Brush.DangerSoft}"
                                BorderBrush="{StaticResource Brush.Danger}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource Brush.Danger}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">

                            <!-- 图形性质 -->
                            <Border Style="{StaticResource SectionPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="图形性质"
                                                   Style="{StaticResource Text.SectionTitle}"
                                                   Margin="0" />
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      HorizontalAlignment="Right"
                                                      IsChecked="{Binding IsPropertiesExpanded, Mode=TwoWay}" />
                                    </Grid>

                                    <StackPanel Visibility="{Binding IsPropertiesExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding PropertyNames}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource PropertyChip}">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource Brush.PrimaryDark}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding PropertyEmptyText}"
                                                   Style="{StaticResource Text.Hint}" />

                                        <TextBlock Text="可制作性暂等同角合法性，等角制作算法接入后细化。"
                                                   Style="{StaticResource Text.Hint}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 角的合法性：折叠时只留统计摘要 -->
                            <Border Style="{StaticResource SectionPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="角的合法性"
                                                   Style="{StaticResource Text.SectionTitle}"
                                                   Margin="0" />
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      HorizontalAlignment="Right"
                                                      IsChecked="{Binding IsAnglesExpanded, Mode=TwoWay}" />
                                    </Grid>

                                    <TextBlock Text="{Binding AngleSummary}"
                                               Style="{StaticResource Text.Hint}"
                                               Margin="0,0,0,8" />

                                    <StackPanel Visibility="{Binding IsAnglesExpanded, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="角"
                                                       Style="{StaticResource TableHeaderText}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="合法性"
                                                       Style="{StaticResource TableHeaderText}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="可制作性"
                                                       Style="{StaticResource TableHeaderText}" />
                                            <TextBlock Grid.Column="3"
                                                       Text="备注"
                                                       Style="{StaticResource TableHeaderText}"
                                                       Margin="0" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Angles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F0EDF8"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="0,5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLegal}" Value="False">
                                                                        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="64" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding AngleText}"
                                                                       Style="{StaticResource TableCellText}" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding LegalityText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock"
                                                                           BasedOn="{StaticResource TableCellText}">
                                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLegal}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding ManufacturabilityText}"
                                                                       Style="{StaticResource TableCellText}"
                                                                       Foreground="{StaticResource Brush.TextMuted}" />

                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding NoteText}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="角的可制作性暂时等同于合法性，等角的制作算法接入后细化。"
                                                   Style="{StaticResource Text.Hint}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 稳定性 -->
                            <Border Style="{StaticResource SectionPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="稳定性"
                                                   Style="{StaticResource Text.SectionTitle}"
                                                   Margin="0" />
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      HorizontalAlignment="Right"
                                                      IsChecked="{Binding IsStabilityExpanded, Mode=TwoWay}" />
                                    </Grid>

                                    <TextBlock Text="{Binding StabilityText}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Text}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsStabilityExpanded, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <!-- 半边稳定性：一轴一块，块内自动换行，整块区域纵向滚动 -->
                            <Border Style="{StaticResource SectionPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="半边稳定性"
                                                   Style="{StaticResource Text.SectionTitle}"
                                                   Margin="0" />
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      HorizontalAlignment="Right"
                                                      IsChecked="{Binding IsHalfExpanded, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- 折叠态摘要 -->
                                    <TextBlock Text="{Binding HalfCollapsedSummary}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Text}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsHalfExpanded, Converter={StaticResource InverseBoolToVis}}" />

                                    <StackPanel Visibility="{Binding IsHalfExpanded, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding HalfSummary}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Style="{StaticResource Text.Hint}"
                                                   Margin="0,4,0,0"
                                                   Text="交换方向合法的定义：两个半边都稳定，并且该方向上左右各两个带柱子的半半边也全部稳定。" />

                                        <!-- 图例：只用颜色区分合法与不合法 -->
                                        <TextBlock Style="{StaticResource Text.Hint}"
                                                   Margin="0,4,0,6">
                                            <Run Text="绿色"
                                                 Foreground="#2E9E5B"
                                                 FontWeight="SemiBold" />
                                            <Run Text=" 为合法方向，" />
                                            <Run Text="红色"
                                                 Foreground="#D64545"
                                                 FontWeight="SemiBold" />
                                            <Run Text=" 为不合法方向。" />
                                        </TextBlock>

                                        <CheckBox Content="只显示合法方向"
                                                  FontSize="12"
                                                  Foreground="{StaticResource Brush.TextMuted}"
                                                  Margin="0,0,0,8"
                                                  IsChecked="{Binding OnlyLegalDirections, Mode=TwoWay}" />

                                        <ScrollViewer MaxHeight="360"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Padding="0,0,4,0">
                                            <ItemsControl ItemsSource="{Binding HalfAxisGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#FBFAFF"
                                                                BorderBrush="#E6E2F2"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="10,8,12,12"
                                                                Margin="0,0,0,10">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#4527A0"
                                                                           Margin="0,0,0,4" />

                                                                <TextBlock Text="{Binding EmptyText}"
                                                                           FontSize="12"
                                                                           Foreground="#8A8A95"
                                                                           Margin="0,2,0,2"
                                                                           Visibility="{Binding HasDirections, Converter={StaticResource InverseBoolToVis}}" />

                                                                <!-- 方向逐个列出、各占一格：宽时一行多个，窄时自动折行 -->
                                                                <ItemsControl ItemsSource="{Binding Directions}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>

                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Display}"
                                                                                       FontSize="13"
                                                                                       FontFamily="Consolas, Microsoft YaHei UI"
                                                                                       MinWidth="168"
                                                                                       Margin="0,2,16,2"
                                                                                       TextWrapping="Wrap">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="#D64545" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsLegal}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#2E9E5B" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--
                                工序卡片：分析时按 CardBuilder 建一次并缓存，
                                有卡片集时用它替换旧的「交换工序」节点图与「角的工序」占位。
                                层顺序固定为 交换工序 → 半边工序 → 角工序。
                            -->
                            <Border Style="{StaticResource SectionPanel}"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0"
                                    Visibility="{Binding HasWorkOrderCards, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="工序卡片"
                                                   Style="{StaticResource Text.SectionTitle}"
                                                   Margin="0" />
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      HorizontalAlignment="Right"
                                                      IsChecked="{Binding IsCardsExpanded, Mode=TwoWay}" />
                                    </Grid>

                                    <TextBlock Text="{Binding CardsSummary}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Text}"
                                               TextWrapping="Wrap" />

                                    <StackPanel Visibility="{Binding IsCardsExpanded, Converter={StaticResource BoolToVis}}">
                                        <!-- 整棵卡片树的说明（顶针 / 堆叠收尾、不可解原因） -->
                                        <TextBlock Text="{Binding CardsNote}"
                                                   Style="{StaticResource Text.Hint}"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding HasCardsNote, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock Style="{StaticResource Text.Hint}"
                                                   Margin="0,6,0,0"
                                                   Text="按「交换工序 → 半边工序 → 角工序」三层从外到内平铺，同一层内一行一张卡；每张卡内部按「输入 → 前态 → 可见步骤 → 输出」横向流式排列，空间不足时卡内自动换行。每张卡显示标题、验证标记、输入（上一层卡产物）、前态、可见步骤与输出。前态画在输入之后、步骤之前（v4 半边卡 = 拆柱后（跌落前），角卡 = 工序起点）；v4 半边卡的可见步骤固定是「交换 → 拆柱 → 跌落」，没有碎晶步。旋转 / 废料 / 纯支撑交接等隐藏步骤不渲染；未验证的卡不显示输入链，只显示 Note。角卡输出已归一化到 Q1：Q1 目标角、Q2 右柱、Q4 左柱（n = 4）。" />

                                        <ItemsControl x:Name="WorkOrderCardsRoot"
                                                      ItemsSource="{Binding CardVisuals.Layers}"
                                                      ItemTemplate="{StaticResource WorkOrderCardLayerTemplate}"
                                                      Margin="0,10,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 制作路径：总开关 + 交换工序 / 角的工序 两个子区域（无卡片集时回退） -->
                            <Border Style="{StaticResource SectionPanel}"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0"
                                    Visibility="{Binding ShowLegacyPathSection, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="制作路径"
                                                   Style="{StaticResource Text.SectionTitle}"
                                                   Margin="0" />
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      HorizontalAlignment="Right"
                                                      IsChecked="{Binding IsPathExpanded, Mode=TwoWay}" />
                                    </Grid>

                                    <StackPanel Visibility="{Binding IsPathExpanded, Converter={StaticResource BoolToVis}}">

                                        <!-- 交换工序：只有存在合法交换方向时才显示 -->
                                        <Border BorderBrush="#E6E2F2"
                                                BorderThickness="0,1,0,0"
                                                Padding="0,12,0,0"
                                                Margin="0,2,0,0"
                                                Visibility="{Binding HasProductionPath, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="交换工序"
                                                               Style="{StaticResource SubSectionTitle}" />
                                                    <ToggleButton Style="{StaticResource SectionToggle}"
                                                                  HorizontalAlignment="Right"
                                                                  IsChecked="{Binding IsPathExchangeExpanded, Mode=TwoWay}" />
                                                </Grid>

                                                <StackPanel Visibility="{Binding IsPathExchangeExpanded, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding PathSummary}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource Brush.Text}"
                                                               TextWrapping="Wrap" />

                                                    <!-- 未覆盖时的小字说明：这并不代表不可制作 -->
                                                    <TextBlock Text="{Binding PathOutcomeNote}"
                                                               Style="{StaticResource Text.Hint}"
                                                               Margin="0,3,0,0"
                                                               Visibility="{Binding HasPathOutcomeNote, Converter={StaticResource BoolToVis}}" />

                                                    <!-- 节点图容器：横纵都可滚动，预览保持 30px 单元格不缩放 -->
                                                    <Border Background="#FBFAFF"
                                                            BorderBrush="#E6E2F2"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            ClipToBounds="True"
                                                            Margin="0,8,0,0">
                                                        <ScrollViewer x:Name="PathGraphScroll"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      MaxHeight="560"
                                                                      HorizontalContentAlignment="Left"
                                                                      VerticalContentAlignment="Top">
                                                            <Grid Width="{Binding PathGraph.Width}"
                                                                  Height="{Binding PathGraph.Height}">

                                                                <!-- 连线画在节点之下 -->
                                                                <ItemsControl ItemsSource="{Binding PathGraph.Edges}"
                                                                              IsHitTestVisible="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>

                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="Canvas.Left" Value="0" />
                                                                            <Setter Property="Canvas.Top" Value="0" />
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>

                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Path Data="{Binding LineGeometry}">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Stroke" Value="#512BD4" />
                                                                                        <Setter Property="StrokeThickness" Value="2" />
                                                                                        <Setter Property="StrokeStartLineCap" Value="Round" />
                                                                                        <Setter Property="StrokeEndLineCap" Value="Round" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsWaste}" Value="True">
                                                                                                <Setter Property="Stroke" Value="#9A9AA5" />
                                                                                                <Setter Property="StrokeDashArray" Value="2.5 2" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 节点卡片 -->
                                                                <ItemsControl ItemsSource="{Binding PathGraph.Nodes}"
                                                                              ItemTemplate="{StaticResource PathGraphNodeTemplate}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>

                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                </ItemsControl>

                                                                <!-- 箭头单独一层，画在节点之上，与工作区一致 -->
                                                                <ItemsControl ItemsSource="{Binding PathGraph.Edges}"
                                                                              IsHitTestVisible="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>

                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="Canvas.Left" Value="0" />
                                                                            <Setter Property="Canvas.Top" Value="0" />
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>

                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Path Data="{Binding ArrowGeometry}">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Fill" Value="#512BD4" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsWaste}" Value="True">
                                                                                                <Setter Property="Fill" Value="#9A9AA5" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </ScrollViewer>
                                                    </Border>

                                                    <TextBlock Style="{StaticResource Text.Hint}"
                                                               Margin="0,6,0,0"
                                                               Text="节点按层从上到下排列，同层节点从左到右紧排，层间固定留 80px 画箭头；行数由制作路径决定（顶针 / 堆叠 / 块会追加新层）。预览保持 30px 单元格原始尺寸，图形较宽或较高时容器可横纵滚动。废料节点淡显、虚线边框，指向废料的箭头为灰色虚线；顶针、堆叠、块分别用青绿 / 橙 / 绿边框与「顶P」「堆」「块」小标签区分。" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 角的工序：始终显示（占位），默认隐藏内容 -->
                                        <Border BorderBrush="#E6E2F2"
                                                BorderThickness="0,1,0,0"
                                                Padding="0,12,0,0"
                                                Margin="0,12,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="角的工序"
                                                               Style="{StaticResource SubSectionTitle}" />
                                                    <ToggleButton Style="{StaticResource SectionToggle}"
                                                                  HorizontalAlignment="Right"
                                                                  IsChecked="{Binding IsPathAnglesExpanded, Mode=TwoWay}" />
                                                </Grid>

                                                <StackPanel Visibility="{Binding IsPathAnglesExpanded, Converter={StaticResource BoolToVis}}">
                                                    <Grid MinHeight="64">
                                                        <Rectangle RadiusX="10"
                                                                   RadiusY="10"
                                                                   Fill="#FAF8FF"
                                                                   Stroke="#B9A9EE"
                                                                   StrokeThickness="1"
                                                                   StrokeDashArray="4 3" />

                                                        <TextBlock Text="待设计：后续按角绘制（每个角补柱后的制作工序）"
                                                                   Foreground="#512BD4"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="14" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
